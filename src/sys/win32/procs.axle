// sys/procs — what a pid is: a name, and where the binary lives.
//
// The name comes from ONE call. `NtQuerySystemInformation` (class 5,
// `SystemProcessInformation`) returns a linked run of variable-length
// records covering every process on the machine with no per-process handle
// to open. The documented alternative — Toolhelp32 plus one `OpenProcess`
// each — is denied on anything running at a higher integrity level, which
// is exactly the half of the list a network audit must not go blank on:
// `svchost`, `System`, and the drivers are where the surprising traffic is.
//
// The **path** is a different matter, and it is resolved lazily. Only a pid
// that actually appears in the connection table is worth a handle, that is
// a few dozen out of four hundred, and the answer is cached for the pid's
// life. A protected process refuses the handle: the name survives, the path
// stays empty, and the tooltip says which of the two happened rather than
// showing a blank the reader has to interpret.

use smalt::Mem;
use crate::sys::raw::{asPtr, isNull, nullPtr};
use crate::model::pool;

@link_name("NtQuerySystemInformation")
extern "C" fn NtQuerySystemInformation(cls : i32, buf : ptr, len : i32, ret : ptr) : i32;

extern "C" from "kernel32" {
    /** `HANDLE OpenProcess(DWORD, BOOL, DWORD)` — null when Windows refuses. */
    fn OpenProcess(access : i32, inherit : i32, pid : i32) : ptr;
    /** `BOOL CloseHandle(HANDLE)`. */
    fn CloseHandle(h : ptr) : i32;
    /**
     * `BOOL QueryFullProcessImageNameW(HANDLE, DWORD, LPWSTR, PDWORD)`.
     * `size` carries the buffer's capacity in **characters** going in and
     * the length written coming out.
     */
    fn QueryFullProcessImageNameW(h : ptr, flags : i32, buf : ptr, size : ptr) : i32;
}

/** `SystemProcessInformation` — the process-list class. */
const SYSTEM_PROCESS_INFORMATION : i32 = 5;
/** `STATUS_INFO_LENGTH_MISMATCH` — the buffer was too small; grow and retry. */
const STATUS_INFO_LENGTH_MISMATCH : i32 = -1073741820; // 0xC0000004
/**
 * `PROCESS_QUERY_LIMITED_INFORMATION` — the weakest right that still answers
 * "where is your image". `PROCESS_QUERY_INFORMATION` would be refused for
 * most of the list; this one is granted for anything at or below our own
 * integrity level.
 */
const PROCESS_QUERY_LIMITED_INFORMATION : i32 = 0x1000;

// ─── SYSTEM_PROCESS_INFORMATION field offsets (x64) ──────────

/** `ULONG NextEntryOffset` — bytes to the next record, 0 at the end. */
const SPI_NEXT : i64 = 0;
/** `USHORT ImageName.Length` — the UTF-16 name length in BYTES. */
const SPI_NAME_LEN : i64 = 56;    // 0x38
/** `PWSTR ImageName.Buffer` — the UTF-16 name, not NUL-terminated. */
const SPI_NAME_BUF : i64 = 64;    // 0x40
/** `HANDLE UniqueProcessId` — the pid, pointer-width. */
const SPI_PID : i64 = 80;         // 0x50

/** Slots the table can hold. */
const MAX_PROCS : i32 = 4096;
/** First snapshot buffer; doubled while the kernel reports it short. */
const SNAP_CAP : i64 = 1048576;
/** Ceiling on that doubling. */
const SNAP_MAX : i64 = 67108864;
/** Longest process name kept, in bytes. */
const NAME_MAX : i32 = 64;
/** Longest image path kept, in bytes. */
const PATH_MAX : i32 = 320;
/** Characters the path scratch holds — Windows caps an extended path here. */
const PATH_CHARS : i32 = 32768;

/** Whether a process's image path is known, and why not when it is not. */
enum PathState : i32 {
    /** The path has not been asked for yet. */
    Untried = 0,
    /** The path is interned and `pathOff` / `pathLen` name it. */
    Known = 1,
    /** Windows refused the handle — a protected or higher-integrity process. */
    Denied = 2,
    /** The process was gone by the time the path was asked for. */
    Gone = 3,
}


/**
 * Every process on the machine, with its name, and its image path for the
 * ones that turned out to matter.
 */
class Procs {
    pid : i64[],
    pub(crate) nameOff : i64[],
    pub(crate) nameLen : i32[],
    pub(crate) pathOff : i64[],
    pub(crate) pathLen : i32[],
    pathState : PathState[],
    seen : i32[],

    count : i32,
    gen : i32,

    snap : i64,
    snapCap : i64,
    wide : i64,
    sizeCell : i64,

    constructor() {
        self.pid = malloc<i64>(MAX_PROCS as i64);
        self.nameOff = malloc<i64>(MAX_PROCS as i64);
        self.nameLen = malloc<i32>(MAX_PROCS as i64);
        self.pathOff = malloc<i64>(MAX_PROCS as i64);
        self.pathLen = malloc<i32>(MAX_PROCS as i64);
        self.pathState = malloc<PathState>(MAX_PROCS as i64);
        self.seen = malloc<i32>(MAX_PROCS as i64);
        self.count = 0;
        self.gen = 0;
        self.snapCap = SNAP_CAP;
        self.snap = Mem::take(SNAP_CAP);
        self.wide = Mem::take((PATH_CHARS as i64) * 2);
        self.sizeCell = Mem::take(8);
    }

    /** The slot holding `pid`, or `-1`. */
    pub(crate) fn find(self, pid : i64) : i32 {
        for (i of 0..self.count) {
            if (self.pid[i] == pid) {
                return i;
            }
        }
        return -1;
    }

    /**
     * Re-read the process list and fold it into the table. A slot survives
     * as long as its pid does, which is what lets the path resolved on the
     * first refresh still be there on the thousandth.
     */
    pub(crate) fn refresh(mut self, pool : Pool) : void {
        if (self.snap == 0) {
            return;
        }
        let st : i32 = self.take();
        if (st != 0) {
            return;
        }

        self.gen = self.gen + 1;
        let off : i64 = 0;
        let more : bool = true;
        while (more) {
            let e : i64 = self.snap + off;
            self.fold(pool, e, Mem::qwordAt(e, SPI_PID));
            let next : i64 = Mem::udwordAt(e, SPI_NEXT);
            if (next == 0) {
                more = false;
            } else {
                off = off + next;
            }
        }
        self.sweep();
    }

    /** Take the snapshot, growing while the kernel reports the buffer short. */
    fn take(mut self) : i32 {
        let st : i32 = NtQuerySystemInformation(
            SYSTEM_PROCESS_INFORMATION, asPtr(self.snap), self.snapCap as i32, nullPtr()
        );
        while (st == STATUS_INFO_LENGTH_MISMATCH && self.snapCap < SNAP_MAX) {
            Mem::release(self.snap);
            self.snapCap = self.snapCap * 2;
            self.snap = Mem::take(self.snapCap);
            if (self.snap == 0) {
                self.snapCap = 0;
                return -1;
            }
            st = NtQuerySystemInformation(
                SYSTEM_PROCESS_INFORMATION, asPtr(self.snap), self.snapCap as i32, nullPtr()
            );
        }
        return st;
    }

    /** Fold one record into its slot, minting the slot if the pid is new. */
    fn fold(mut self, pool : Pool, e : i64, pid : i64) : void {
        let s : i32 = self.find(pid);
        if (s < 0) {
            if (self.count >= MAX_PROCS) {
                return;
            }
            s = self.count;
            self.count = s + 1;
            self.pid[s] = pid;
            self.pathState[s] = PathState::Untried;
            self.pathOff[s] = -1;
            self.pathLen[s] = 0;
            self.nameOff[s] = pool.putWide(
                Mem::qwordAt(e, SPI_NAME_BUF), Mem::wordAt(e, SPI_NAME_LEN) / 2, NAME_MAX
            );
            self.nameLen[s] = 0;
            if (self.nameOff[s] >= 0) {
                let chars : i32 = Mem::wordAt(e, SPI_NAME_LEN) / 2;
                if (chars > NAME_MAX) {
                    chars = NAME_MAX;
                }
                self.nameLen[s] = chars;
            }
        }
        self.seen[s] = self.gen;
    }

    /**
     * Drop the slots this refresh did not see. The hole is filled from the
     * tail rather than by shifting: nothing outside this table addresses a
     * slot by index — every caller arrives with a pid — so the order of the
     * storage carries no meaning.
     */
    fn sweep(mut self) : void {
        let i : i32 = 0;
        while (i < self.count) {
            if (self.seen[i] != self.gen) {
                let last : i32 = self.count - 1;
                if (i != last) {
                    self.pid[i] = self.pid[last];
                    self.nameOff[i] = self.nameOff[last];
                    self.nameLen[i] = self.nameLen[last];
                    self.pathOff[i] = self.pathOff[last];
                    self.pathLen[i] = self.pathLen[last];
                    self.pathState[i] = self.pathState[last];
                    self.seen[i] = self.seen[last];
                }
                self.count = last;
            } else {
                i = i + 1;
            }
        }
    }

    /**
     * Resolve slot `s`'s image path if it has not been tried, and answer
     * what happened. One handle, opened and closed inside this call: holding
     * a query handle across the refresh loop would keep a dead process's
     * record alive in the kernel and make the list disagree with the
     * machine.
     *
     * The span interned here is this pid's own copy, and the thirty pids of
     * one browser therefore intern thirty identical paths. That duplication
     * is deliberate: it makes the cache a plain per-pid field with no
     * lifetime shared across slots, and it costs at most a few hundred
     * kilobytes for the pids that have sockets. `model::groups` interns the
     * one copy that is keyed on.
     */
    pub(crate) fn resolvePath(mut self, pool : Pool, s : i32) : PathState {
        if (s < 0 || s >= self.count) {
            return PathState::Gone;
        }
        if (self.pathState[s] != PathState::Untried) {
            return self.pathState[s];
        }
        if (self.wide == 0 || self.sizeCell == 0) {
            self.pathState[s] = PathState::Denied;
            return PathState::Denied;
        }

        let h : ptr = OpenProcess(
            PROCESS_QUERY_LIMITED_INFORMATION, 0, self.pid[s] as i32
        );
        if (isNull(h)) {
            self.pathState[s] = PathState::Denied;
            return PathState::Denied;
        }
        Mem::putDword(self.sizeCell, 0, PATH_CHARS);
        let ok : i32 = QueryFullProcessImageNameW(
            h, 0, asPtr(self.wide), asPtr(self.sizeCell)
        );
        CloseHandle(h);
        if (ok == 0) {
            self.pathState[s] = PathState::Denied;
            return PathState::Denied;
        }

        let chars : i32 = Mem::udwordAt(self.sizeCell, 0) as i32;
        self.pathOff[s] = pool.putWide(self.wide, chars, PATH_MAX);
        if (self.pathOff[s] < 0) {
            self.pathState[s] = PathState::Denied;
            return PathState::Denied;
        }
        if (chars > PATH_MAX) {
            chars = PATH_MAX;
        }
        self.pathLen[s] = chars;
        self.pathState[s] = PathState::Known;
        return PathState::Known;
    }

    /** Release the raw buffers; the column arrays are freed with the object. */
    pub(crate) fn dispose(mut self) : void {
        if (self.snap != 0) {
            Mem::release(self.snap);
            self.snap = 0;
        }
        if (self.wide != 0) {
            Mem::release(self.wide);
            self.wide = 0;
        }
        if (self.sizeCell != 0) {
            Mem::release(self.sizeCell);
            self.sizeCell = 0;
        }
    }
}

/** Why a program row shows no path, in the words the tooltip uses. */
fn pathNote(state : PathState) : string {
    return match state {
        PathState::Denied => "path refused by Windows (protected process)",
        PathState::Gone => "the process exited before its path could be read",
        PathState::Untried => "path not read yet",
        _ => "",
    };
}
