// sys/conn — who is talking to whom, straight from the OS.
//
// Two calls per family per protocol — `GetExtendedTcpTable` and
// `GetExtendedUdpTable` in their `OWNER_PID` classes — answer the one
// question no other Windows interface answers whole: which **process** owns
// each socket. `netstat -ano` is this call; the Performance counters give
// bytes without the peer, and a raw socket gives the packet without the
// process.
//
// The four snapshots are normalised here into one flat run of rows, so
// everything above this file sees a single kind of thing: a row is a
// protocol, a family, an owning pid, a state, a local port, and a remote
// address and port. IPv4 and IPv6 differ only in how many of the sixteen
// address bytes are meaningful, which `family` says.
//
// What the tables do NOT carry, stated once so nothing above invents it:
// no byte counts, and no peer for a UDP socket — the OS simply does not
// record one for a connectionless handle. A UDP row is a socket that is
// open, which is worth showing and worth not overstating.


use smalt::Mem;
use crate::sys::raw::{asPtr};

extern "C" from "iphlpapi" {
    /**
     * `DWORD GetExtendedTcpTable(PVOID, PDWORD, BOOL, ULONG, TCP_TABLE_CLASS, ULONG)`.
     * `0` on success, `122` (`ERROR_INSUFFICIENT_BUFFER`) when the buffer is
     * short — `size` is then the length needed.
     */
    fn GetExtendedTcpTable(
        table : ptr,
        size : ptr,
        order : i32,
        family : i32,
        cls : i32,
        reserved : i32
    ) : i32;

    /** `DWORD GetExtendedUdpTable(PVOID, PDWORD, BOOL, ULONG, UDP_TABLE_CLASS, ULONG)`. */
    fn GetExtendedUdpTable(
        table : ptr,
        size : ptr,
        order : i32,
        family : i32,
        cls : i32,
        reserved : i32
    ) : i32;
}

/** `AF_INET`. */
const AF_INET : i32 = 2;
/** `AF_INET6`. */
const AF_INET6 : i32 = 23;
/** `TCP_TABLE_OWNER_PID_ALL` — every state, with the owning pid. */
const TCP_TABLE_OWNER_PID_ALL : i32 = 5;
/** `UDP_TABLE_OWNER_PID`. */
const UDP_TABLE_OWNER_PID : i32 = 1;
/** `ERROR_INSUFFICIENT_BUFFER` — grow and retry. */
const ERROR_INSUFFICIENT_BUFFER : i32 = 122;

// ─── Record geometry (x64) ───────────────────────────────────
//
// Each table is a `DWORD dwNumEntries` followed by a packed array of rows.
// The rows are walked by offset; nothing is marshalled.

/** Bytes from a table's base to its first row. */
const TABLE_ROWS : i64 = 4;

/** `MIB_TCPROW_OWNER_PID` — state, local, remote, pid. */
const TCP4_ROW : i64 = 24;
/** `DWORD dwState`. */
const TCP4_STATE : i64 = 0;
/** `DWORD dwLocalAddr` — an `in_addr`, already in wire order. */
const TCP4_LOCAL_ADDR : i64 = 4;
/** `DWORD dwLocalPort` — the port sits in the low word, big-endian. */
const TCP4_LOCAL_PORT : i64 = 8;
/** `DWORD dwRemoteAddr`. */
const TCP4_REMOTE_ADDR : i64 = 12;
/** `DWORD dwRemotePort`. */
const TCP4_REMOTE_PORT : i64 = 16;
/** `DWORD dwOwningPid`. */
const TCP4_PID : i64 = 20;

/** `MIB_TCP6ROW_OWNER_PID`. */
const TCP6_ROW : i64 = 56;
/** `UCHAR ucLocalAddr[16]`. */
const TCP6_LOCAL_ADDR : i64 = 0;
/** `DWORD dwLocalPort`. */
const TCP6_LOCAL_PORT : i64 = 20;
/** `UCHAR ucRemoteAddr[16]`. */
const TCP6_REMOTE_ADDR : i64 = 24;
/** `DWORD dwRemotePort`. */
const TCP6_REMOTE_PORT : i64 = 44;
/** `DWORD dwState`. */
const TCP6_STATE : i64 = 48;
/** `DWORD dwOwningPid`. */
const TCP6_PID : i64 = 52;

/** `MIB_UDPROW_OWNER_PID`. */
const UDP4_ROW : i64 = 12;
/** `DWORD dwLocalAddr`. */
const UDP4_LOCAL_ADDR : i64 = 0;
/** `DWORD dwLocalPort`. */
const UDP4_LOCAL_PORT : i64 = 4;
/** `DWORD dwOwningPid`. */
const UDP4_PID : i64 = 8;

/** `MIB_UDP6ROW_OWNER_PID`. */
const UDP6_ROW : i64 = 28;
/** `UCHAR ucLocalAddr[16]`. */
const UDP6_LOCAL_ADDR : i64 = 0;
/** `DWORD dwLocalPort`. */
const UDP6_LOCAL_PORT : i64 = 20;
/** `DWORD dwOwningPid`. */
const UDP6_PID : i64 = 24;

// ─── The normalised row ──────────────────────────────────────

/** Which transport a row came from. */
enum Proto : i32 {
    /** A TCP row. */
    Tcp = 0,
    /** A UDP row: a socket that is open, with no peer the OS will name. */
    Udp = 1,
}


/** `MIB_TCP_STATE_LISTEN` — inbound, no peer. */
const TCP_LISTEN : i32 = 2;
/** `MIB_TCP_STATE_SYN_SENT` — an outbound connection being opened. */
const TCP_SYN_SENT : i32 = 3;
/** `MIB_TCP_STATE_ESTAB` — the state a live conversation sits in. */
const TCP_ESTAB : i32 = 5;
/** `MIB_TCP_STATE_TIME_WAIT` — the peer is gone, the tuple is cooling. */
const TCP_TIME_WAIT : i32 = 11;
/** A UDP row carries no TCP state; this is what it reports instead. */
const STATE_NONE : i32 = 0;

/** Rows the snapshot can hold. A machine past this is a machine in trouble. */
const CONN_MAX_ROWS : i32 = 8192;
/** Address bytes per row — sixteen, so an IPv6 row needs no second store. */
const CONN_ADDR_BYTES : i64 = 16;
/** First buffer for one table; doubled while the OS reports it short. */
const BUF_CAP : i64 = 262144;
/** Ceiling on that doubling. */
const BUF_MAX : i64 = 16777216;

/**
 * One snapshot of every socket on the machine, in column form.
 *
 * The buffer and the address pool are allocated once and reused: a refresh
 * every second that allocated its own storage would put this program near
 * the top of the list it draws.
 */
class Conns {
    pub(crate) proto : Proto[] = malloc<Proto>(CONN_MAX_ROWS as i64),
    pub(crate) family : i32[] = malloc<i32>(CONN_MAX_ROWS as i64),
    pub(crate) pid : i32[] = malloc<i32>(CONN_MAX_ROWS as i64),
    pub(crate) state : i32[] = malloc<i32>(CONN_MAX_ROWS as i64),
    pub(crate) localPort : i32[] = malloc<i32>(CONN_MAX_ROWS as i64),
    pub(crate) remotePort : i32[] = malloc<i32>(CONN_MAX_ROWS as i64),

    pub(crate) count : i32 = 0,
    pub(crate) ok : bool = false,

    addrs : i64 = Mem::take((CONN_MAX_ROWS as i64) * CONN_ADDR_BYTES),
    buf : i64 = Mem::take(BUF_CAP),
    bufCap : i64 = BUF_CAP,
    sizeCell : i64 = Mem::take(8),

    /**
     * Byte address of row `i`'s sixteen address bytes: the remote end for a
     * connection, the local bind for a listening socket or a UDP handle.
     */
    pub(crate) fn addrAt(self, i : i32) : i64 {
        return self.addrs + (i as i64) * CONN_ADDR_BYTES;
    }

    /**
     * Re-read all four tables. `ok` is false when the machine refused every
     * one of them, which is the only case in which the caller should keep
     * the previous snapshot rather than believe an empty one.
     */
    pub(crate) fn refresh(mut self) : void {
        if (self.buf == 0 || self.addrs == 0 || self.sizeCell == 0) {
            self.ok = false;
            return;
        }

        self.count = 0;
        let any : bool = false;
        if (self.take(AF_INET, true)) {
            self.foldTcp4();
            any = true;
        }

        if (self.take(AF_INET6, true)) {
            self.foldTcp6();
            any = true;
        }

        if (self.take(AF_INET, false)) {
            self.foldUdp4();
            any = true;
        }

        if (self.take(AF_INET6, false)) {
            self.foldUdp6();
            any = true;
        }

        self.ok = any;
    }

    /**
     * Read one table into `buf`, growing while the OS reports the buffer
     * short. The size needed changes with every socket opened between the
     * two calls, which is why this is a loop and not a pair of calls.
     */
    fn take(mut self, family : i32, tcp : bool) : bool {
        for (tries of 0..8) {
            Mem::putDword(self.sizeCell, 0, self.bufCap as i32);
            let st : i32 = 0;
            if (tcp) {
                st = GetExtendedTcpTable(
                    asPtr(self.buf), asPtr(self.sizeCell), 0,
                    family, TCP_TABLE_OWNER_PID_ALL, 0
                );
            } else {
                st = GetExtendedUdpTable(
                    asPtr(self.buf), asPtr(self.sizeCell), 0,
                    family, UDP_TABLE_OWNER_PID, 0
                );
            }

            if (st == 0) {
                return true;
            }

            if (st != ERROR_INSUFFICIENT_BUFFER || self.bufCap >= BUF_MAX) {
                return false;
            }

            // Grow into a new block before letting go of the old one: a failed
            // allocation then costs one refresh, not the rest of the session.
            let grown : i64 = Mem::take(self.bufCap * 2);
            if (grown == 0) {
                return false;
            }

            Mem::release(self.buf);
            self.buf = grown;
            self.bufCap = self.bufCap * 2;
        }

        return false;
    }

    /** The row count the table in `buf` declares, capped by what fits. */
    fn declared(self, rowSize : i64) : i32 {
        let n : i64 = Mem::udwordAt(self.buf, 0);
        let fits : i64 = (self.bufCap - TABLE_ROWS) / rowSize;
        if (n > fits) {
            n = fits;
        }

        let room : i64 = (CONN_MAX_ROWS as i64) - (self.count as i64);
        if (n > room) {
            n = room;
        }

        if (n < 0) {
            return 0;
        }

        return n as i32;
    }

    /**
     * Mint a row and answer its index, or `-1` when the snapshot is full.
     * The address bytes are cleared here so a v4 row's upper twelve are
     * never whatever the previous refresh left behind.
     */
    fn mint(mut self, proto : Proto, family : i32, pid : i32, state : i32) : i32 {
        if (self.count >= CONN_MAX_ROWS) {
            return -1;
        }

        let i : i32 = self.count;
        self.count = i + 1;
        self.proto[i] = proto;
        self.family[i] = family;
        self.pid[i] = pid;
        self.state[i] = state;
        self.localPort[i] = 0;
        self.remotePort[i] = 0;
        Mem::clear(self.addrAt(i), CONN_ADDR_BYTES);
        return i;
    }

    /**
     * Which of a TCP record's two addresses is the one worth keeping.
     *
     * A listening socket has no peer — its remote address is sixteen zero
     * bytes — and what a reader wants to know about it is the interface it
     * is bound to, because `0.0.0.0:4444` and `127.0.0.1:4444` are a very
     * different sentence. So a `LISTEN` row carries its local address and
     * every other row carries its peer's.
     */
    fn which(self, e : i64, localOff : i64, remoteOff : i64, stateOff : i64) : i64 {
        if ((Mem::udwordAt(e, stateOff) as i32) == TCP_LISTEN) {
            return localOff;
        }

        return remoteOff;
    }

    /** Copy `n` address bytes from the record at `e + off` into row `i`. */
    fn addr(mut self, i : i32, e : i64, off : i64, n : i64) : void {
        let dst : i64 = self.addrAt(i);
        for (b of 0..n) {
            Mem::putByte(dst, b, Mem::byteAt(e, off + b));
        }
    }

    /** Fold the IPv4 TCP table currently in `buf`. */
    fn foldTcp4(mut self) : void {
        let n : i32 = self.declared(TCP4_ROW);
        for (r of 0..n) {
            let e : i64 = self.buf + TABLE_ROWS + (r as i64) * TCP4_ROW;
            let i : i32 = self.mint(
                Proto::Tcp, 4,
                Mem::udwordAt(e, TCP4_PID) as i32,
                Mem::udwordAt(e, TCP4_STATE) as i32
            );
            if (i < 0) {
                return;
            }

            self.localPort[i] = Mem::wordBeAt(e, TCP4_LOCAL_PORT);
            self.remotePort[i] = Mem::wordBeAt(e, TCP4_REMOTE_PORT);
            self.addr(i, e, self.which(e, TCP4_LOCAL_ADDR, TCP4_REMOTE_ADDR, TCP4_STATE), 4);
        }
    }

    /** Fold the IPv6 TCP table currently in `buf`. */
    fn foldTcp6(mut self) : void {
        let n : i32 = self.declared(TCP6_ROW);
        for (r of 0..n) {
            let e : i64 = self.buf + TABLE_ROWS + (r as i64) * TCP6_ROW;
            let i : i32 = self.mint(
                Proto::Tcp, 6,
                Mem::udwordAt(e, TCP6_PID) as i32,
                Mem::udwordAt(e, TCP6_STATE) as i32
            );
            if (i < 0) {
                return;
            }

            self.localPort[i] = Mem::wordBeAt(e, TCP6_LOCAL_PORT);
            self.remotePort[i] = Mem::wordBeAt(e, TCP6_REMOTE_PORT);
            self.addr(i, e, self.which(e, TCP6_LOCAL_ADDR, TCP6_REMOTE_ADDR, TCP6_STATE), 16);
        }
    }

    /** Fold the IPv4 UDP table currently in `buf`. */
    fn foldUdp4(mut self) : void {
        let n : i32 = self.declared(UDP4_ROW);
        for (r of 0..n) {
            let e : i64 = self.buf + TABLE_ROWS + (r as i64) * UDP4_ROW;
            let i : i32 = self.mint(
                Proto::Udp, 4, Mem::udwordAt(e, UDP4_PID) as i32, STATE_NONE
            );
            if (i < 0) {
                return;
            }

            self.localPort[i] = Mem::wordBeAt(e, UDP4_LOCAL_PORT);
            self.addr(i, e, UDP4_LOCAL_ADDR, 4);
        }
    }

    /** Fold the IPv6 UDP table currently in `buf`. */
    fn foldUdp6(mut self) : void {
        let n : i32 = self.declared(UDP6_ROW);
        for (r of 0..n) {
            let e : i64 = self.buf + TABLE_ROWS + (r as i64) * UDP6_ROW;
            let i : i32 = self.mint(
                Proto::Udp, 6, Mem::udwordAt(e, UDP6_PID) as i32, STATE_NONE
            );
            if (i < 0) {
                return;
            }

            self.localPort[i] = Mem::wordBeAt(e, UDP6_LOCAL_PORT);
            self.addr(i, e, UDP6_LOCAL_ADDR, 16);
        }
    }

    /** Release the raw buffers; the column arrays are freed with the object. */
    pub(crate) fn dispose(mut self) : void {
        if (self.buf != 0) {
            Mem::release(self.buf);
            self.buf = 0;
        }

        if (self.addrs != 0) {
            Mem::release(self.addrs);
            self.addrs = 0;
        }

        if (self.sizeCell != 0) {
            Mem::release(self.sizeCell);
            self.sizeCell = 0;
        }
    }
}

/** Whether a TCP state means the tuple is still a live conversation. */
fn isLive(state : i32) : bool {
    return state == TCP_ESTAB || state == TCP_SYN_SENT;
}

/** The human name of a TCP state, as the detail card reports it. */
fn stateName(state : i32) : string {
    return match state {
        1 => "closed",
        2 => "listening",
        3 => "opening",
        4 => "accepting",
        5 => "established",
        6 => "closing",
        7 => "closing",
        8 => "close wait",
        9 => "closing",
        10 => "last ack",
        11 => "time wait",
        12 => "deleting",
        _ => "open",
    };
}
