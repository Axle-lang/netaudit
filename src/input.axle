// input — keys, clicks and wheel turned into changes on `app`.
//
// Nothing here draws and nothing here reads the OS. It maps an event onto a
// change of interaction state, and hands back an **action** for the things
// it cannot do itself: quit, force a refresh, clear the journal, open a
// folder, write a snapshot.
//
// Every movement goes through the flat row list, so the keyboard and the
// pointer agree on what "the next row" means — including the fact that an
// endpoint under a folded program is not a row at all. And every selection
// is stored as a key: by the time the reader presses Down again, the tree
// has been rebuilt and the index they moved from means something else.

use smalt::{Event, MouseButton, Scancode};
use crate::ui::tree;
use crate::ui::chrome;
use crate::app::{App, Modal, Say, Hot};
use crate::session::Session;
use crate::theme::Layout;
use crate::model::view::{View, RowKind, Sort, rowOfEndpoint, rowOfGroup};
use crate::model::groups::Groups;
use crate::sys::tiers::Tier;

/**
 * What the loop must do that this file cannot do itself.
 *
 * Everything else an event causes is a change on `App`, made here. These
 * need the window, the OS or the journal, so they are handed back as a
 * value the loop matches on — and the match is exhaustive, so an action
 * added here is one the loop is made to handle.
 */
enum Action : i32 {
    /** Nothing for the loop to do. */
    None = 0,
    /** Close the window. */
    Quit = 1,
    /** Re-read the machine now rather than at the next tick. */
    Refresh = 2,
    /** Open the folder holding the selected program's binary. */
    Open = 3,
    /** Forget the journal and start again from what is live. */
    Clear = 4,
    /** Write what is on screen to a file. */
    Snap = 5,
}

/** The flat-list position of whatever is selected, or `-1`. */
fn selectedRow(ss : Session) : i32 {
    let a : App = ss.a;
    if (!a.selected) {
        return -1;
    }

    return match a.selKind {
        RowKind::Group => rowOfGroup(ss.w.view, ss.w.groups, a.selKey),
        RowKind::Endpoint => rowOfEndpoint(ss.w.view, ss.w.eps, a.selKey),
    };
}

/** Select the row at flat position `r`, and scroll it into view. */
fn selectRow(ss : Session, r : i32) : void {
    let a : App = ss.a;
    let v : View = ss.w.view;
    if (r < 0 || r >= v.count) {
        return;
    }

    if (v.rowKind[r] == RowKind::Group) {
        a.selectGroup(ss.w.groups.key[v.rowRef[r]]);
    } else {
        a.selectEndpoint(ss.w.eps.key[v.rowRef[r]]);
    }

    a.scroll = tree::reveal(a.lay, v, r, a.scroll);
}

/** Move the selection `delta` rows, clamped to the ends of the list. */
fn moveSel(ss : Session, delta : i32) : void {
    let v : View = ss.w.view;
    if (v.count == 0) {
        return;
    }

    let from : i32 = selectedRow(ss);
    if (from < 0) {
        selectRow(ss, 0);
        return;
    }

    selectRow(ss, (from + delta).max(0).min(v.count - 1));
}

/** The group a row belongs to: itself if it is one, otherwise the one above. */
fn groupOf(v : View, r : i32) : i32 {
    let i : i32 = r;
    while (i >= 0) {
        if (v.rowKind[i] == RowKind::Group) {
            return v.rowRef[i];
        }

        i = i - 1;
    }

    return -1;
}

/** Route a key by what currently has focus. */
fn onKey(ss : Session, sc : Scancode) : Action {
    if (ss.a.modal != Modal::None) {
        return modalKey(ss.a, sc);
    }

    if (ss.a.typing) {
        return typingKey(ss, sc);
    }

    return browsingKey(ss, sc);
}

/**
 * Keys while a card is up. Esc, Enter, Space and F1 close it; O still opens
 * the program's folder, which is what the detail card's footer offers; Q
 * still quits. Everything else is swallowed rather than acting on the tree
 * hidden behind the card.
 */
fn modalKey(a : App, sc : Scancode) : Action {
    if (a.modal == Modal::SortMenu) {
        return menuKey(a, sc);
    }

    if (sc == Scancode::Escape || sc == Scancode::Return || sc == Scancode::KeypadEnter
        || sc == Scancode::Space || sc == Scancode::F1) {
        a.modal = Modal::None;
        a.dirty = true;
        return Action::None;
    }

    if (sc == Scancode::O && a.modal == Modal::Detail) {
        return Action::Open;
    }

    if (sc == Scancode::Q) {
        return Action::Quit;
    }

    return Action::None;
}

/** Keys while the sort menu is open: the arrows move, Enter picks, Esc closes. */
fn menuKey(a : App, sc : Scancode) : Action {
    if (sc == Scancode::Up) {
        a.movePick(-1);
    } else if (sc == Scancode::Down) {
        a.movePick(1);
    } else if (sc == Scancode::Return || sc == Scancode::KeypadEnter || sc == Scancode::Space) {
        a.pickSort();
    } else if (sc == Scancode::Escape || sc == Scancode::S) {
        a.modal = Modal::None;
        a.dirty = true;
    } else if (sc == Scancode::Q) {
        return Action::Quit;
    }

    return Action::None;
}

/**
 * Keys while the filter field has focus. Navigation stays live: the point
 * of narrowing the list is to pick something out of it.
 */
fn typingKey(ss : Session, sc : Scancode) : Action {
    let a : App = ss.a;
    if (sc == Scancode::Escape) {
        a.clearFilter();
        return Action::None;
    }

    if (sc == Scancode::Return || sc == Scancode::KeypadEnter) {
        a.typing = false;
        a.dirty = true;
        return Action::None;
    }

    if (sc == Scancode::Backspace) {
        a.backspace();
        return Action::None;
    }

    if (sc == Scancode::Up) {
        moveSel(ss, -1);
    }

    if (sc == Scancode::Down) {
        moveSel(ss, 1);
    }

    return Action::None;
}

/** Keys while the tree has focus. */
fn browsingKey(ss : Session, sc : Scancode) : Action {
    // Esc backs out of whatever is narrowing the view and never closes the
    // window: a key pressed to dismiss something must not be able to end
    // the session the reader was in the middle of. Q quits.
    if (sc == Scancode::Escape) {
        if (ss.a.filterLen > 0) {
            ss.a.clearFilter();
        }

        return Action::None;
    }

    if (sc == Scancode::Q) {
        return Action::Quit;
    }

    if (sc == Scancode::Up) {
        moveSel(ss, -1);
        return Action::None;
    }

    if (sc == Scancode::Down) {
        moveSel(ss, 1);
        return Action::None;
    }

    if (sc == Scancode::PageUp) {
        moveSel(ss, 0 - tree::pageRows(ss.a.lay));
        return Action::None;
    }

    if (sc == Scancode::PageDown) {
        moveSel(ss, tree::pageRows(ss.a.lay));
        return Action::None;
    }

    if (sc == Scancode::Home) {
        selectRow(ss, 0);
        return Action::None;
    }

    if (sc == Scancode::End) {
        selectRow(ss, ss.w.view.count - 1);
        return Action::None;
    }

    return foldKey(ss, sc);
}

/** The keys that open and close what the tree is showing. */
fn foldKey(ss : Session, sc : Scancode) : Action {
    let a : App = ss.a;
    let v : View = ss.w.view;
    let g : Groups = ss.w.groups;
    let r : i32 = selectedRow(ss);

    if (sc == Scancode::Right) {
        let gi : i32 = groupOf(v, r);
        if (gi >= 0 && !g.isOpen(gi)) {
            g.toggle(gi);
            a.dirty = true;
        }

        return Action::None;
    }

    if (sc == Scancode::Left) {
        let gi : i32 = groupOf(v, r);
        if (gi >= 0) {
            // Left on an endpoint climbs to its program first; only a
            // second press folds it. Folding out from under the reader on
            // the first press loses the row they were looking at.
            if (r >= 0 && v.rowKind[r] == RowKind::Endpoint) {
                a.selectGroup(g.key[gi]);
            } else if (g.isOpen(gi)) {
                g.toggle(gi);
            }

            a.dirty = true;
        }

        return Action::None;
    }

    if (sc == Scancode::Return || sc == Scancode::KeypadEnter) {
        if (r >= 0 && v.rowKind[r] == RowKind::Group) {
            g.toggle(v.rowRef[r]);
            a.dirty = true;
        } else if (r >= 0) {
            a.modal = Modal::Detail;
            a.dirty = true;
        }

        return Action::None;
    }

    if (sc == Scancode::Num8) {
        g.setAll(!anyOpen(g));
        a.dirty = true;
        return Action::None;
    }

    return commandKey(a, sc);
}

/** Whether any program row is currently open. */
fn anyOpen(g : Groups) : bool {
    for (i of 0..g.count) {
        if (g.isOpen(i)) {
            return true;
        }
    }

    return false;
}

/** The keys that change what the window is doing rather than where it is. */
fn commandKey(a : App, sc : Scancode) : Action {
    if (sc == Scancode::Slash) {
        // The `/` that opened the field would otherwise arrive again as the
        // first typed character.
        a.typing = true;
        a.swallow = true;
        a.dirty = true;
        return Action::None;
    }

    if (sc == Scancode::S) {
        a.nextSort();
        return Action::None;
    }

    if (sc == Scancode::L) {
        flipLocal(a);
        return Action::None;
    }

    if (sc == Scancode::B) {
        flipBound(a);
        return Action::None;
    }

    if (sc == Scancode::O) {
        return Action::Open;
    }

    if (sc == Scancode::C) {
        return Action::Clear;
    }

    if (sc == Scancode::Space) {
        a.paused = !a.paused;
        if (a.paused) {
            a.saying(Say::Paused);
        } else {
            a.saying(Say::Resumed);
        }

        return Action::None;
    }

    if (sc == Scancode::F5 || sc == Scancode::R) {
        return Action::Refresh;
    }

    if (sc == Scancode::F1) {
        a.modal = Modal::Help;
        a.dirty = true;
        return Action::None;
    }

    if (sc == Scancode::F12) {
        return Action::Snap;
    }

    return Action::None;
}

/** Show or hide traffic that never leaves the building, and say which. */
fn flipLocal(a : App) : void {
    a.showLocal = !a.showLocal;
    a.saying(Say::Local);
}

/** Show or hide listening sockets and UDP handles, and say which. */
fn flipBound(a : App) : void {
    a.showBound = !a.showBound;
    a.saying(Say::Bound);
}

/** A typed character, once the `/` that opened the field has been eaten. */
fn onText(a : App, c : i32) : Action {
    if (!a.typing) {
        return Action::None;
    }

    if (a.swallow) {
        a.swallow = false;
        return Action::None;
    }

    a.typeByte(c);
    return Action::None;
}

/**
 * The pointer moved. Two things follow: the hovered row changes, and — while
 * the pointer is over the rows — reordering is frozen, so nothing the reader
 * is about to click can move first.
 */
fn onMotion(ss : Session, nowMs : i64, x : i32, y : i32) : Action {
    let a : App = ss.a;
    let v : View = ss.w.view;
    a.pointerMoved(nowMs, x, y);

    if (a.dragging) {
        tree::dragTo(a, v, y);
        a.holdOrder(nowMs);
        return Action::None;
    }

    a.setHot(hotFor(a, x, y));
    if (a.modal == Modal::SortMenu) {
        a.pointAtPick(chrome::menuItemAt(x, y));
    }

    let was : i32 = a.hoverRow;
    a.hoverRow = tree::rowAtPoint(v, a, x, y);
    a.inTree = tree::inRows(a.lay, x, y);
    if (a.inTree) {
        a.holdOrder(nowMs);
    }

    if (a.hoverRow != was) {
        a.dirty = true;
    }

    return Action::None;
}

/**
 * What the pointer at `(x, y)` is over, given what is open: with the sort
 * menu up only its entries react, and under a card nothing does.
 */
fn hotFor(a : App, x : i32, y : i32) : Hot {
    if (a.modal == Modal::None) {
        return hotAt(a.lay, x, y);
    }

    if (a.modal == Modal::SortMenu && chrome::menuItemAt(x, y) >= 0) {
        return Hot::Menu;
    }

    return Hot::None;
}

/**
 * A mouse button went down. Only the left one does anything, and the test
 * is here rather than in the loop: which buttons a program answers is an
 * input decision, not a dispatch one.
 */
fn onClick(ss : Session, ev : Event) : Action {
    let a : App = ss.a;
    if (ev.button != MouseButton::Left) {
        return Action::None;
    }

    if (a.modal == Modal::SortMenu) {
        // A ranking picks; anywhere else, the sort control included, puts
        // the menu away without acting on what is under it.
        let item : i32 = chrome::menuItemAt(ev.x, ev.y);
        if (item >= 0) {
            a.menuPick = item;
            a.pickSort();
        } else {
            a.modal = Modal::None;
            a.dirty = true;
        }

        return Action::None;
    }

    if (a.modal != Modal::None) {
        // A click on the card is a reader reading it; only a click on the
        // dimmed page around it means "put it away".
        if (!a.cardRect.contains(ev.x, ev.y)) {
            a.modal = Modal::None;
            a.dirty = true;
        }

        return Action::None;
    }

    let hot : Hot = hotAt(a.lay, ev.x, ev.y);
    if (hot != Hot::Filter && hot != Hot::Clear) {
        a.typing = false;
    }

    a.pressed = true;
    a.dirty = true;
    clickOn(ss, hot, ev);
    return Action::None;
}

/**
 * A left click on `hot`. The same hit test decides what the pointer lights
 * up, what shape it takes and what a click does — so a control answers
 * exactly where it shows that it will.
 */
fn clickOn(ss : Session, hot : Hot, ev : Event) : void {
    let a : App = ss.a;
    match hot {
        Hot::Clear => clearOrType(a),
        Hot::Filter => {
            a.typing = true;
        }
        Hot::Sort => a.openSortMenu(),
        Hot::Local => flipLocal(a),
        Hot::Bound => flipBound(a),
        Hot::HeadProgram => sortBy(a, Sort::Salience),
        Hot::HeadTrust => sortBy(a, Sort::Risk),
        Hot::HeadRhythm => sortBy(a, Sort::Hits),
        Hot::HeadTraffic => sortBy(a, Sort::Traffic),
        Hot::Bar => tree::grab(a, ss.w.view, ev.y),
        Hot::Rows => clickRow(ss, ev.x, ev.y),
        Hot::Menu => {}
        Hot::TierPoll => {}
        Hot::TierDns => {}
        Hot::TierEtw => {}
        Hot::None => {}
    }
}

/** The clear control empties a filter, and on an empty one starts typing. */
fn clearOrType(a : App) : void {
    if (a.filterLen > 0) {
        a.clearFilter();
    } else {
        a.typing = true;
    }
}

/** Rank by a column header: its first reading, or its second when already on the first. */
fn sortBy(a : App, key : Sort) : void {
    a.sortByColumn(key, tree::alternate(key));
}

/**
 * A click on the rows: it selects the row, and on a program's chevron it
 * folds the program too.
 */
fn clickRow(ss : Session, x : i32, y : i32) : void {
    let v : View = ss.w.view;
    let r : i32 = tree::rowAtPoint(v, ss.a, x, y);
    if (r < 0) {
        return;
    }

    selectRow(ss, r);
    if (v.rowKind[r] == RowKind::Group && tree::onTwisty(x)) {
        ss.w.groups.toggle(v.rowRef[r]);
    }
}

/** A release ends a scrollbar drag; nothing else is held. */
fn onRelease(a : App, ev : Event) : Action {
    if (ev.button != MouseButton::Left) {
        return Action::None;
    }

    if (a.dragging || a.pressed) {
        a.dragging = false;
        a.pressed = false;
        a.dirty = true;
    }

    return Action::None;
}

/** The control under `(x, y)`, with nothing open over the window. */
fn hotAt(lay : Layout, x : i32, y : i32) : Hot {
    let (overTier, tier) = chrome::tierAt(lay, x, y);
    if (overTier) {
        return match tier {
            Tier::Poll => Hot::TierPoll,
            Tier::Dns => Hot::TierDns,
            Tier::Etw => Hot::TierEtw,
        };
    }

    // The clear control sits inside the field, so it is asked first.
    if (chrome::onFilterClear(x, y)) {
        return Hot::Clear;
    }

    if (chrome::onFilter(x, y)) {
        return Hot::Filter;
    }

    if (chrome::onSort(x, y)) {
        return Hot::Sort;
    }

    let toggle : i32 = chrome::onToggle(x, y);
    if (toggle == 0) {
        return Hot::Local;
    }

    if (toggle == 1) {
        return Hot::Bound;
    }

    let (onHeader, col) = tree::headerAt(lay, x, y);
    if (onHeader) {
        return tree::headHot(col);
    }

    if (tree::onBar(lay, x, y)) {
        return Hot::Bar;
    }

    if (tree::inRows(lay, x, y)) {
        return Hot::Rows;
    }

    return Hot::None;
}

/** The wheel scrolls the rows — not while a card is covering them. */
fn onWheel(ss : Session, notches : i32) : Action {
    if (ss.a.modal != Modal::None) {
        return Action::None;
    }

    tree::wheel(ss.a, ss.w.view, notches);
    return Action::None;
}
