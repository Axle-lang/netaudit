// ui/tree — the list itself: program rows, the endpoint rows folded under
// them, the scrollbar, and the hit-testing that turns a click into a row.
//
// The layout was decided in `model/view`, which produced a flat run of rows
// with a top and a height each. This file only draws it and answers "which
// row is under this point", both of which are reads of that layout — so a
// row can never be drawn at one place and clicked at another.
//
// An endpoint takes two lines. It has to: the address, the name behind it,
// the network that owns it, the country, the trust score, the rhythm and the
// traffic are seven facts, and squeezing seven onto one line makes all seven
// unreadable. The first line is *what it is*, the second is *what is known
// about it* — so a reader skimming for addresses reads only the upper lines,
// and one auditing attribution reads only the lower ones.

use smalt::{Frame, Rect, Color, Mem};
use crate::fmt;
use crate::ui::paint::{Paint, Lane};
use crate::ui::parts;
use crate::app::{App, Hot, Touch};
use crate::session::Session;
use crate::model::world::World;
use crate::model::pool::Bytes;
use crate::model::view::{View, RowKind, rowAt, Sort};
use crate::model::endpoints::{Endpoints, SocketKind, kindBadge};
use crate::model::groups::Groups;
use crate::model::hosts::{Hosts, Look, NameSource};
use crate::model::rhythm::{hasRhythm, regularityWord};
use crate::model::addr::{reachWord, Reach};
use crate::sys::conn::{Proto, stateName};
use crate::theme::{Layout, ROWS_Y, TREE_Y, HEAD_H, ROW_GROUP, ROW_ENDPOINT};
use crate::theme::{C_CARD, C_HEADER, C_LINE, C_STRIPE, C_GROUP, C_HOVER, C_SEL, C_SEL_EDGE};
use crate::theme::{C_TEXT, C_DIM, C_FAINT, C_ACCENT, C_MEM, C_CLOSED, C_LOCAL};
use crate::theme::{C_TCP, C_UDP, C_OK, C_WARN, C_HOT};

/** Left edge of the tree box. */
const T_X : i32 = 20;

/** Width of the scrollbar. */
const BAR_W : i32 = 6;
/** Shortest the scrollbar thumb is allowed to get. */
const THUMB_MIN : i32 = 34;

/** Disclosure chevron. */
const X_TWISTY : i32 = 34;
/** The click target of the chevron ends here. */
const TWISTY_END : i32 = 48;
/** A program's monogram. */
const X_AVATAR : i32 = 52;
/** Program name on a group row. */
const X_GROUP_NAME : i32 = 84;
/** How wide a program name may be before it is elided. */
const W_GROUP_NAME : i32 = 330;

/** The branch line linking an endpoint to its program. */
const X_GUIDE : i32 = 62;
/** Protocol chip on an endpoint row. */
const X_CHIP : i32 = 72;
/** The address, and the connection state beneath it. */
const X_ADDR : i32 = 148;
/** The host name, and the owning network beneath it. */
const X_HOST : i32 = 432;
/** How wide a name or a network may be before it is elided. */
const W_HOST : i32 = 296;
/** The two-letter country code. */
const X_CC : i32 = 744;
/** The trust meter. */
const X_PIPS : i32 = 784;
/** The rhythm reading. */
const X_RHY : i32 = 884;

// A group row reuses the endpoint row's TRUST lane so the meters line up
// down the whole tree, and everything it counts is placed **outside** that
// lane — the process count is right-aligned before it, the flagged count
// left-aligned after it, and they never run through it.

/** Process count on a group row, right-aligned. */
const G_PROCS : i32 = 728;
/** Flagged count on a group row, left-aligned after the meter. */
const G_FLAGGED : i32 = 856;

/** Baseline of an endpoint row's first line, from the row's top. */
const LINE_1 : i32 = 18;
/** Baseline of its second line. */
const LINE_2 : i32 = 35;
/** Baseline of the column legend: `TREE_Y` + 22. */
const LEGEND_BASE : i32 = 254;

/** How far the wheel moves the rows in one notch. */
const WHEEL_STEP : i32 = 60;

// ─── Geometry and hit tests ──────────────────────────────────

/** The tree box. */
fn treeRect(lay : Layout) : Rect {
    return Rect::make(T_X, TREE_Y, lay.treeW, lay.treeBottom - TREE_Y);
}

/** The scrolling rows, inside the box's outline. */
fn rowsRect(lay : Layout) : Rect {
    return Rect::make(T_X + 1, ROWS_Y, lay.treeW - 2, lay.rowsH);
}

/** The largest scroll offset that still shows content. */
fn maxScroll(lay : Layout, v : View) : i32 {
    return (v.height - lay.rowsH).max(0);
}

/** Whether `(mx, my)` is inside the scrolling rows. */
fn inRows(lay : Layout, mx : i32, my : i32) : bool {
    return rowsRect(lay).contains(mx, my);
}

/**
 * Whether `mx` is on a program row's disclosure chevron.
 *
 * Folding is the chevron's job and selecting is the row's. A row that did
 * both would make it impossible to look at a program's totals without
 * closing the endpoints you were reading.
 */
fn onTwisty(mx : i32) : bool {
    return mx >= T_X && mx < TWISTY_END;
}

/** The row under `(mx, my)`, or `-1`. */
fn rowAtPoint(v : View, a : App, mx : i32, my : i32) : i32 {
    if (!inRows(a.lay, mx, my)) {
        return -1;
    }

    return rowAt(v, my - ROWS_Y + a.scroll);
}

/**
 * A scroll offset that brings row `r` fully into view, moving as little as
 * possible. Scrolling further than needed loses the reader's place, which
 * is the thing keyboard navigation exists to preserve.
 */
fn reveal(lay : Layout, v : View, r : i32, scroll : i32) : i32 {
    if (r < 0 || r >= v.count) {
        return scroll;
    }

    let top : i32 = v.rowTop[r];
    let bottom : i32 = top + v.rowH[r];
    if (top < scroll) {
        return top;
    }

    if (bottom > scroll + lay.rowsH) {
        return bottom - lay.rowsH;
    }

    return scroll;
}

/** How many rows a page key moves by: what fits, less one for context. */
fn pageRows(lay : Layout) : i32 {
    return (lay.rowsH / ROW_ENDPOINT - 1).max(1);
}

/** Move the rows by `notches` wheel steps, held inside the content. */
fn wheel(a : App, v : View, notches : i32) : void {
    let scroll : i32 = a.scroll - notches * WHEEL_STEP;
    a.scroll = scroll.max(0).min(maxScroll(a.lay, v));
    a.dirty = true;
}

/**
 * The ranking the header under `(mx, my)` asks for. Answers the *first* of
 * the column's two readings; `App::sortByColumn` decides which of the pair a
 * click lands on.
 */
fn headerAt(lay : Layout, mx : i32, my : i32) : (onHeader: bool, key: Sort) {
    if (my < TREE_Y || my >= TREE_Y + HEAD_H) {
        return (false, Sort::Salience);
    }

    if (mx >= lay.xRight - 170 && mx <= lay.xRight) {
        return (true, Sort::Traffic);
    }

    if (mx >= X_RHY && mx < lay.xRight - 180) {
        return (true, Sort::Hits);
    }

    if (mx >= X_CC && mx < X_RHY) {
        return (true, Sort::Risk);
    }

    if (mx >= X_GROUP_NAME && mx < X_HOST) {
        return (true, Sort::Salience);
    }

    return (false, Sort::Salience);
}

// ─── The box and its legend ──────────────────────────────────

/** The whole tree: surface, legend, rows, scrollbar. */
fn drawTree(p : Paint, ss : Session) : void {
    parts::outline(p.f, treeRect(p.lay), 12, C_LINE, C_CARD);
    legend(p, ss);

    if (ss.w.view.count == 0) {
        empty(p, ss);
        return;
    }

    // One clipped pass, inside the box's outline: a row crossing the
    // viewport edge is cut mid-pixel, and no row can draw over the outline
    // or the chrome around it.
    let whole : Frame = p.clipTo(rowsRect(p.lay));
    rows(p, ss);
    p.unclip(whole);

    scrollbar(p, ss);
}

/**
 * The column legend, which is also the ranking control.
 *
 * A header that names a column and does nothing when clicked is a header
 * every reader tries once. Each of these ranks by what it names, and the
 * active one is drawn in the accent ink and underlined, so the order on
 * screen always has a visible cause.
 */
fn legend(p : Paint, ss : Session) : void {
    // Inside the box's outline, so the strip never paints over it.
    let w : i32 = p.lay.treeW - 2;
    p.f.fillRound(Rect::make(T_X + 1, TREE_Y + 1, w, HEAD_H - 1), 11, C_HEADER);
    p.f.fillRect(Rect::make(T_X + 1, TREE_Y + HEAD_H - 12, w, 12), C_HEADER);
    p.f.hLine(T_X + 1, TREE_Y + HEAD_H - 1, w, C_LINE);

    header(p, ss, X_GROUP_NAME, "Program / endpoint", Sort::Salience);

    // `Name / network` is deliberately not a control: the name it shows is
    // the one the first column already ranks by, and two headers that claim
    // the same ranking leave a reader unable to tell which one they pressed.
    p.text(X_HOST, LEGEND_BASE, "Name / network", C_FAINT);

    header(p, ss, X_CC, "Trust", Sort::Risk);
    header(p, ss, X_RHY, "Repetition / rhythm", Sort::Hits);

    let traffic : string = "Traffic / last seen";
    header(p, ss, p.lay.xRight - p.width(traffic), traffic, Sort::Traffic);
}

/**
 * One header whose label starts at `x`, lit when it is the reason for the
 * order. Under the pointer it gets a plate, like any button: it is one, and
 * a reader should not have to click it to find that out.
 */
fn header(p : Paint, ss : Session, x : i32, label : string, key : Sort) : void {
    let on : bool = ss.a.sortKey == key || ss.a.sortKey == alternate(key);
    let touch : Touch = ss.a.touch(headHot(key));
    let w : i32 = p.width(label);

    if (touch != Touch::Idle) {
        let plate : i32 = Color::mix(C_HEADER, C_TEXT, 1, 14);
        if (touch == Touch::Press) {
            plate = Color::mix(C_HEADER, 0x000000, 1, 4);
        }

        p.f.fillRound(Rect::make(x - 8, TREE_Y + 6, w + 16, HEAD_H - 12), 6, plate);
    }

    let ink : i32 = C_DIM;
    if (on) {
        ink = C_ACCENT;
    } else if (touch != Touch::Idle) {
        ink = C_TEXT;
    }

    p.text(x, LEGEND_BASE, label, ink);

    if (on) {
        p.f.fillRound(Rect::make(x, LEGEND_BASE + 6, w, 2), 1, C_ACCENT);
    }
}

/** The hover target of the header that ranks by `key`. */
fn headHot(key : Sort) : Hot {
    return match key {
        Sort::Salience => Hot::HeadProgram,
        Sort::Risk => Hot::HeadTrust,
        Sort::Hits => Hot::HeadRhythm,
        Sort::Traffic => Hot::HeadTraffic,
        Sort::Name => Hot::None,
        Sort::Rhythm => Hot::None,
        Sort::Recent => Hot::None,
    };
}

/** The second reading a two-part column offers when clicked again. */
fn alternate(key : Sort) : Sort {
    return match key {
        Sort::Salience => Sort::Name,
        Sort::Hits => Sort::Rhythm,
        Sort::Traffic => Sort::Recent,
        Sort::Risk => Sort::Risk,
        Sort::Rhythm => Sort::Rhythm,
        Sort::Name => Sort::Name,
        Sort::Recent => Sort::Recent,
    };
}

/** What the tree says when there is nothing to show. */
fn empty(p : Paint, ss : Session) : void {
    let a : App = ss.a;
    let w : i32 = p.lay.treeW;
    let cx : i32 = T_X + w / 2;
    let cy : i32 = ROWS_Y + 150;

    p.f.disc(cx, cy, 28, C_HEADER);
    p.f.ring(cx, cy, 14, C_FAINT);
    p.f.disc(cx, cy, 4, C_FAINT);

    let first : Rect = Rect::make(T_X, cy + 40, w, 20);
    let second : Rect = Rect::make(T_X, cy + 64, w, 20);

    if (a.filterLen > 0) {
        let lead : string = "Nothing matches ";
        let typed : Bytes = a.filterBytes();
        let width : i32 = p.width(lead) + p.bytesWidth(typed);
        let pen : i32 = p.text(cx - width / 2, cy + 54, lead, C_DIM);
        p.bytes(pen, cy + 54, typed, C_TEXT);
        p.textCentred(second, "Esc clears the filter.", C_FAINT);
        return;
    }

    let line1 : string = "Nothing on this machine is talking to the internet right now.";
    let line2 : string = "L also shows local traffic, B also shows listening and UDP sockets.";
    p.textCentred(first, line1, C_DIM);
    p.textCentred(second, line2, C_FAINT);
}

// ─── Rows ────────────────────────────────────────────────────

/** Every visible row; `p` is already clipped to the scrolling area. */
fn rows(p : Paint, ss : Session) : void {
    let v : View = ss.w.view;
    let bottom : i32 = ROWS_Y + p.lay.rowsH;

    for (r of 0..v.count) {
        let y : i32 = ROWS_Y + v.rowTop[r] - ss.a.scroll;
        if (y + v.rowH[r] <= ROWS_Y || y >= bottom) {
            continue;
        }

        if (v.rowKind[r] == RowKind::Group) {
            groupRow(p, ss, v.rowRef[r], r, y);
        } else {
            endpointRow(p, ss, v.rowRef[r], r, y);
        }
    }
}

/** Whether row `r` is the last endpoint before the next program (or the end). */
fn lastInRun(v : View, r : i32) : bool {
    return r + 1 >= v.count || v.rowKind[r + 1] == RowKind::Group;
}

/** How a row is being looked at: selected, under the pointer, or neither. */
struct RowState {
    pub(crate) selected : bool;
    pub(crate) hovered : bool;
}

/**
 * The surface a row sits on. Hover and selection are inset, rounded plates
 * rather than full-width bands, so the row under the pointer reads as a
 * thing that can be pressed.
 */
fn rowBack(p : Paint, r : Rect, state : RowState, base : i32) : void {
    p.f.fillRect(r, base);

    let plate : Rect = Rect::make(r.x + 6, r.y + 2, r.w - 24, r.h - 4);
    if (state.selected) {
        p.f.fillRound(plate, 8, C_SEL);
        p.f.fillRound(Rect::make(r.x + 6, r.y + 8, 3, r.h - 16), 1, C_SEL_EDGE);
    } else if (state.hovered) {
        p.f.fillRound(plate, 8, C_HOVER);
    }
}

/** One program row: the fold, the monogram, the name, and its totals. */
fn groupRow(p : Paint, ss : Session, gi : i32, r : i32, y : i32) : void {
    let g : Groups = ss.w.groups;
    let state : RowState = RowState {
        selected: ss.a.isSelected(RowKind::Group, g.key[gi]),
        hovered: ss.a.hoverRow == r,
    };
    rowBack(p, Rect::make(T_X, y, p.lay.treeW, ROW_GROUP), state, C_GROUP);
    if (r > 0) {
        p.f.hLine(T_X, y, p.lay.treeW, C_LINE);
    }

    let cy : i32 = y + ROW_GROUP / 2;
    let base : i32 = cy + 5;
    parts::twisty(p.f, X_TWISTY, cy, g.isOpen(gi), C_DIM);
    groupName(p, ss, gi, cy);

    let procs : i32 = g.pids[gi];
    countRight(p, G_PROCS, base, procs, plural(procs, " process", " processes"));
    parts::meter(p.f, X_PIPS, cy, g.worst[gi]);

    if (g.flagged[gi] > 0) {
        p.count(g.flagged[gi] as i64);
        let pen : i32 = p.figure(G_FLAGGED, base, C_HOT);
        p.text(pen, base, " flagged", C_FAINT);
    }

    let shown : i32 = g.endpoints[gi];
    p.count(shown as i64);
    let pen : i32 = p.figure(X_RHY, base, C_DIM);
    p.text(pen, base, plural(shown, " endpoint", " endpoints"), C_FAINT);

    livePill(p, cy, g.live[gi]);

    if (g.rate(gi) > 0) {
        p.scratch.reset();
        fmt::rate(p.scratch, g.rate(gi));
        p.figureRight(p.lay.xRight, base, C_MEM);
    }
}

/** A program's monogram and name, and a note when it was grouped by name. */
fn groupName(p : Paint, ss : Session, gi : i32, cy : i32) : void {
    let g : Groups = ss.w.groups;
    let base : i32 = cy + 5;
    let name : Bytes = ss.w.groupName(gi);
    let pen : i32 = X_GROUP_NAME;

    if (name.some()) {
        parts::avatar(p, X_AVATAR, cy, Mem::byteAt(name.at, 0), g.key[gi]);
        pen = p.boldBytes(Lane::at(X_GROUP_NAME, W_GROUP_NAME), base, name, C_TEXT);
    } else {
        // A pid the kernel named with an empty string: the System process
        // and a few drivers. The row still has to say something a reader can
        // point at, and "" is not it.
        parts::avatar(p, X_AVATAR, cy, 83, g.key[gi]);
        pen = p.bold(X_GROUP_NAME, base, "System and drivers", C_TEXT);
    }

    if (!g.identified(gi)) {
        parts::ghostChip(p, pen + 10, cy - 9, "by name");
    }
}

/** How many of a program's endpoints are open now, as a pill ending at the live column. */
fn livePill(p : Paint, cy : i32, live : i32) : void {
    let right : i32 = p.lay.gLive;
    if (live == 0) {
        p.textRight(right - 10, cy + 5, "idle", C_FAINT);
        return;
    }

    p.count(live as i64);
    let w : i32 = p.figureWidth() + p.width(" live") + 30;
    let x : i32 = right - w;
    p.f.fillRound(Rect::make(x, cy - 10, w, 20), 10, Color::mix(C_GROUP, C_OK, 1, 7));
    p.f.disc(x + 12, cy, 3, C_OK);

    let pen : i32 = p.figure(x + 21, cy + 5, C_OK);
    p.text(pen, cy + 5, " live", C_OK);
}

/** `one` when there is one of something, `many` otherwise. */
fn plural(n : i32, one : string, many : string) : string {
    if (n == 1) {
        return one;
    }

    return many;
}

/** A figure and its unit, right-aligned at `right`. */
fn countRight(p : Paint, right : i32, base : i32, n : i32, unit : string) : void {
    p.textRight(right, base, unit, C_FAINT);
    p.count(n as i64);
    p.figureRight(right - p.width(unit), base, C_DIM);
}

/** The ink a protocol chip is drawn in. */
fn protoInk(e : Endpoints, s : i32) : i32 {
    if (e.kind[s] == SocketKind::Listen) {
        return C_ACCENT;
    }

    if (e.proto[s] == Proto::Udp) {
        return C_UDP;
    }

    return C_TCP;
}

/**
 * Endpoint `s`, drawn as row `r` at `y`, over two lines: what it is, then
 * what is known about it.
 *
 * A row whose sockets are all gone is drawn in the closed ink and says how
 * long ago that was. It is still there because this is a journal — a
 * conversation that ended two minutes ago is often the one being looked for.
 */
fn endpointRow(p : Paint, ss : Session, s : i32, r : i32, y : i32) : void {
    let e : Endpoints = ss.w.eps;
    let stripe : i32 = C_CARD;
    if (r % 2 == 1) {
        stripe = C_STRIPE;
    }

    let state : RowState = RowState {
        selected: ss.a.isSelected(RowKind::Endpoint, e.key[s]),
        hovered: ss.a.hoverRow == r,
    };
    rowBack(p, Rect::make(T_X, y, p.lay.treeW, ROW_ENDPOINT), state, stripe);
    branch(p, y, lastInRun(ss.w.view, r));

    let live : bool = e.liveNow[s] > 0;
    let badge : string = kindBadge(e.kind[s], e.proto[s]);
    if (live) {
        parts::chip(p, X_CHIP, y + 4, badge, protoInk(e, s));
    } else {
        parts::ghostChip(p, X_CHIP, y + 4, badge);
    }

    addressLine(p, ss, s, y);
    stateLine(p, ss, s, y);
    identity(p, ss, s, y);
    rhythmLine(p, ss, s, y);
    trafficLine(p, ss, s, y);
}

/** The branch: a line down from the program, and a tick into the row at `y`. */
fn branch(p : Paint, y : i32, last : bool) : void {
    let tick : i32 = y + 13;
    if (last) {
        p.f.vLine(X_GUIDE, y, tick - y, C_LINE);
    } else {
        p.f.vLine(X_GUIDE, y, ROW_ENDPOINT, C_LINE);
    }

    p.f.hLine(X_GUIDE, tick, X_CHIP - X_GUIDE - 4, C_LINE);
}

/**
 * Line one, left: the address and port. An uncompressed v6 address can
 * outrun the column, so it is cut with an ellipsis rather than drawn under
 * the host name.
 */
fn addressLine(p : Paint, ss : Session, s : i32, y : i32) : void {
    let e : Endpoints = ss.w.eps;
    let ink : i32 = C_TEXT;
    if (e.liveNow[s] == 0) {
        ink = C_CLOSED;
    }

    p.scratch.reset();
    fmt::addrPort(p.scratch, e.addrAt(s), e.family[s], e.port[s]);
    let lane : Lane = Lane::at(X_ADDR, X_HOST - X_ADDR - 12);
    p.bytesElided(lane, y + LINE_1, p.figureBytes(), ink);
}

/**
 * Line two, left: what the socket is doing, with a light for it — green for
 * an open conversation, amber for one still winding down, grey once every
 * socket is gone.
 */
fn stateLine(p : Paint, ss : Session, s : i32, y : i32) : void {
    let e : Endpoints = ss.w.eps;
    let live : bool = e.liveNow[s] > 0;
    let light : i32 = C_OK;
    let word : string = stateName(e.state[s]);

    if (e.kind[s] == SocketKind::Listen) {
        light = C_ACCENT;
    } else if (e.proto[s] == Proto::Udp) {
        light = C_UDP;
        word = "bound";
    } else if (!live && e.sockets[s] > 0) {
        light = C_WARN;
    } else if (!live) {
        // How long ago it closed is the right-hand column's job; saying it
        // twice on one row makes a reader check whether the two agree.
        light = C_CLOSED;
        word = "closed";
    }

    let base : i32 = y + LINE_2;
    p.f.disc(X_ADDR + 3, base - 4, 3, light);
    p.text(X_ADDR + 12, base, word, C_FAINT);
}

/**
 * The two attribution lines: the name on top, the network beneath, then the
 * country and the trust meter.
 *
 * When there is no name the row says which of the reasons applies — not
 * routable, not looked up yet, looked up and unanswered, or answered with
 * nothing — because those are different situations and only some are a wait.
 */
fn identity(p : Paint, ss : Session, s : i32, y : i32) : void {
    let w : World = ss.w;
    let e : Endpoints = w.eps;
    let h : i32 = e.host[s];
    if (h < 0) {
        return;
    }

    let hosts : Hosts = w.hosts;
    let b1 : i32 = y + LINE_1;
    let lane : Lane = Lane::at(X_HOST, W_HOST);
    let name : Bytes = w.hostName(h);
    let ink : i32 = C_TEXT;
    if (e.liveNow[s] == 0) {
        ink = C_CLOSED;
    }

    if (name.some()) {
        p.bytesElided(lane, b1, name, ink);
    } else if (e.kind[s] == SocketKind::Listen && hosts.reach[h] == Reach::None) {
        p.text(X_HOST, b1, "every interface", C_LOCAL);
    } else if (hosts.reach[h] != Reach::Public) {
        p.text(X_HOST, b1, reachWord(hosts.reach[h]), C_LOCAL);
    } else {
        p.text(X_HOST, b1, unnamedWord(hosts, h), C_FAINT);
    }

    let network : Bytes = w.network(h);
    p.bytesElided(lane, y + LINE_2, network, C_FAINT);

    let cc : Bytes = w.countryCode(h);
    if (cc.some()) {
        p.f.fillRound(Rect::make(X_CC - 4, b1 - 13, 26, 18), 5, C_HEADER);
        p.bytes(X_CC + 1, b1, cc, C_DIM);
    }

    parts::meter(p.f, X_PIPS, b1 - 4, e.score[s]);
}

/** What a public address with no name is waiting for, if anything. */
fn unnamedWord(hosts : Hosts, h : i32) : string {
    return match hosts.look[h] {
        Look::New => "waiting for lookup",
        Look::Sent => "looking up...",
        Look::Local => "not routable",
        Look::Failed => resolvingWord(hosts, h, "lookup failed"),
        Look::Done => resolvingWord(hosts, h, "no name published"),
    };
}

/** The reverse lookup still to come, or `settled` once it has answered empty. */
fn resolvingWord(hosts : Hosts, h : i32, settled : string) : string {
    if (hosts.nameFrom[h] == NameSource::None) {
        return "resolving name...";
    }

    return settled;
}

/**
 * Repetition on line one, rhythm on line two — the pair of readings this
 * program exists to surface. A row visited once says so plainly rather than
 * claiming a period it cannot have measured.
 */
fn rhythmLine(p : Paint, ss : Session, s : i32, y : i32) : void {
    let e : Endpoints = ss.w.eps;
    let b1 : i32 = y + LINE_1;
    let b2 : i32 = y + LINE_2;

    if (e.hits[s] == 1) {
        p.text(X_RHY, b1, "seen once", C_FAINT);
    } else {
        let ink : i32 = C_DIM;
        if (e.hits[s] >= 5) {
            ink = C_TEXT;
        }

        p.scratch.reset();
        fmt::times(p.scratch, e.hits[s] as i64);
        let pen : i32 = p.figure(X_RHY, b1, ink);
        p.text(pen + 6, b1, "visits", C_FAINT);
    }

    if (!hasRhythm(e.rhythm, s)) {
        // A row seen once has already said so on the line above; repeating
        // "not enough visits" under every one of forty rows is noise that
        // teaches the reader to stop looking at this column.
        if (e.hits[s] > 1) {
            p.text(X_RHY, b2, "no steady interval yet", C_FAINT);
        }

        return;
    }

    let pen : i32 = p.text(X_RHY, b2, "every ", C_FAINT);
    p.scratch.reset();
    p.scratch.elapsed(e.rhythm.periodMs[s]);
    pen = p.figure(pen, b2, C_DIM);
    parts::dot(p.f, pen + 8, b2 - 4, C_FAINT);

    let regular : i32 = e.rhythm.regular[s];
    let word : i32 = C_FAINT;
    if (regular >= 750) {
        word = C_ACCENT;
    }

    p.text(pen + 16, b2, regularityWord(regular), word);
}

/**
 * The right-hand column: what moved on line one, how long this has been
 * going on beneath it.
 *
 * Without the kernel trace there is no byte figure, so line one says whether
 * the conversation is open and, when it is not, how long ago it stopped.
 * Leaving it blank would waste the one column a reader scans for "is this
 * current", and printing a zero would claim a measurement never taken.
 */
fn trafficLine(p : Paint, ss : Session, s : i32, y : i32) : void {
    let e : Endpoints = ss.w.eps;
    let right : i32 = p.lay.xRight;
    let b1 : i32 = y + LINE_1;
    let b2 : i32 = y + LINE_2;

    if (e.bytesIn[s] + e.bytesOut[s] > 0) {
        p.scratch.reset();
        fmt::rate(p.scratch, e.rate(s));
        p.figureRight(right, b1, C_MEM);
    } else if (e.liveNow[s] > 0) {
        p.textRight(right, b1, "open now", C_DIM);
    } else {
        let since : i64 = e.lastMs[s];
        if (e.closedMs[s] > 0) {
            since = e.closedMs[s];
        }

        p.scratch.reset();
        p.scratch.elapsed(p.nowMs - since + 1);
        p.textRight(right, b1, " ago", C_FAINT);
        p.figureRight(right - p.width(" ago"), b1, C_CLOSED);
    }

    p.scratch.reset();
    p.scratch.elapsed(e.lastMs[s] - e.firstMs[s] + 1);
    p.textRight(right - p.figureWidth(), b2, "known for ", C_FAINT);
    p.figureRight(right, b2, C_FAINT);
}

// ─── Scrollbar ───────────────────────────────────────────────

/** The scrollbar, drawn only when there is something to scroll. */
fn scrollbar(p : Paint, ss : Session) : void {
    let lay : Layout = p.lay;
    let v : View = ss.w.view;
    let a : App = ss.a;
    if (maxScroll(lay, v) <= 0) {
        return;
    }

    // At rest a thin, quiet thumb; reached for, it widens onto a visible
    // track — the overlay scrollbar every modern list has taught readers.
    let x : i32 = lay.barX;
    let w : i32 = BAR_W;
    let ink : i32 = Color::mix(C_CARD, C_DIM, 1, 3);
    if (a.dragging || a.hot == Hot::Bar) {
        x = lay.barX - 2;
        w = BAR_W + 4;
        ink = C_DIM;
        if (a.dragging) {
            ink = C_TEXT;
        }

        p.f.fillRound(Rect::make(x, ROWS_Y, w, lay.rowsH), w / 2, C_HEADER);
    }

    let top : i32 = ROWS_Y + thumbTop(lay, v, a.scroll);
    let thumb : Rect = Rect::make(x, top, w, thumbHeight(lay, v));
    p.f.fillRound(thumb, w / 2, ink);
}

/** How tall the thumb is, floored so it stays grabbable on a long list. */
fn thumbHeight(lay : Layout, v : View) : i32 {
    if (v.height <= 0) {
        return lay.rowsH;
    }

    let h : i32 = (lay.rowsH * lay.rowsH) / v.height;
    return h.max(THUMB_MIN).min(lay.rowsH);
}

/** Where the thumb sits for a given scroll offset. */
fn thumbTop(lay : Layout, v : View, scroll : i32) : i32 {
    let over : i32 = maxScroll(lay, v);
    if (over <= 0) {
        return 0;
    }

    return ((lay.rowsH - thumbHeight(lay, v)) * scroll) / over;
}

/** The scroll offset that would put the thumb's top at `top`. */
fn scrollForThumb(lay : Layout, v : View, top : i32) : i32 {
    let travel : i32 = lay.rowsH - thumbHeight(lay, v);
    if (travel <= 0) {
        return 0;
    }

    let over : i32 = maxScroll(lay, v);
    return ((over * top) / travel).max(0).min(over);
}

/** Whether `(mx, my)` is on the scrollbar's track. */
fn onBar(lay : Layout, mx : i32, my : i32) : bool {
    let track : Rect = Rect::make(lay.barX - 4, ROWS_Y, BAR_W + 8, lay.rowsH);
    return track.contains(mx, my);
}

/**
 * Begin a drag, or jump. Pressing on the thumb grabs it where it was
 * grabbed — the list must not lurch by however far the pointer happened to
 * be from the thumb's top — and pressing anywhere else on the track centres
 * the thumb there, which is what a reader means by clicking below it.
 */
fn grab(a : App, v : View, my : i32) : void {
    let top : i32 = thumbTop(a.lay, v, a.scroll);
    let h : i32 = thumbHeight(a.lay, v);
    let at : i32 = my - ROWS_Y;

    if (at >= top && at < top + h) {
        a.dragGrip = at - top;
    } else {
        a.dragGrip = h / 2;
        a.scroll = scrollForThumb(a.lay, v, at - h / 2);
    }

    a.dragging = true;
    a.dirty = true;
}

/** Continue a drag: the grip stays under the pointer. */
fn dragTo(a : App, v : View, my : i32) : void {
    a.scroll = scrollForThumb(a.lay, v, my - ROWS_Y - a.dragGrip);
    a.dirty = true;
}
