// ui/detail — the sheet behind Enter: one endpoint, said in full, with the
// score taken apart. And the keyboard reference.
//
// A grid row has to fit seven facts on two lines, which means every one of
// them is abbreviated. This is where they are not. Its most important
// section is the last one: **why the score is what it is**, one line per
// signal, each with the points it cost or earned. A trust reading that
// cannot be interrogated is a reading that will be either believed blindly
// or ignored entirely, and both are worse than no reading.

use zaffre::{
    Widget, Column, Row, FlexProps, Label, LabelProps, Eyebrow, Tag, TagProps, ScoreMeter, ReasonList, ReasonProps,
    Reason, Scroll, ScrollProps, Button, ButtonProps, ButtonKind, IconKind, Spacer, Divider, DescriptionList, Tone,
    TextRole, BadgeSize, Align, Length, Insets, Justify, BadgeLook, StatLook, ControlSize, Elevation,
};
use std::text::StringBuilder;
use crate::fmt;
use crate::ui::text;
use crate::ui::actions;
use crate::ui::live::Tall;
use crate::session::Session;
use crate::model::world::World;
use crate::model::endpoints::{Endpoints, SocketKind, kindBadge};
use crate::model::groups::Groups;
use crate::model::hosts::{Hosts, nameSource, lookNote, FLAG_PROXY, FLAG_HOSTING, FLAG_MOBILE};
use crate::model::rhythm::{hasRhythm, regularityWord};
use crate::model::addr::{reachWord, Reach};
use crate::model::score::{Signal, reasonAt, reasonBit, reasonWeight, reasonText, REASON_COUNT};
use crate::sys::conn::stateName;

/** The width the scrollbar takes at the right of the sheet's content. */
const BAR_ROOM : f64 = 16.0;

/** What the sheet's header and padding take of the window's height, so the scroll inside it fits what is left. */
const SHEET_CHROME : f64 = 112.0;

/** The sheet's title: the name a reader knows the endpoint by. */
pub fn title(ss : Shared<Session>) : string {
    let s : i32 = actions::pickedEndpoint(ss);
    if (s < 0) {
        return "Endpoint";
    }

    let w : World = ss.w;
    let h : i32 = w.eps.host[s as i64];
    if (h >= 0 && w.hostName(h).some()) {
        return text::spanText(w.hostName(h));
    }

    return addrText(ss, s);
}

/** Endpoint `s`'s address and port. */
fn addrText(ss : Shared<Session>, s : i32) : string {
    let e : Endpoints = ss.w.eps;
    ss.a.scratch.reset();
    fmt::addrPort(ss.a.scratch, e.addrAt(s), e.family[s as i64], e.port[s as i64]);
    return text::scratchText(ss.a.scratch);
}

/** A term and its value on one line, the value wrapped if it is long. */
fn fact(into : Column, term : string, value : string) : void {
    if (value.byteLength == 0) {
        return;
    }

    let kids : dyn Widget[] = [
        new Label(LabelProps { role: TextRole::Faint, width: Length::Px(112.0) }, term),
        new Label(LabelProps { role: TextRole::Body, wrap: true, grow: 1.0 }, value),
    ];
    into.add(new Row(FlexProps { gap: 12.0, align: Align::Start, width: Length::Fill }, kids));
}

/** A heading over a group of facts. */
fn section(into : Column, name : string) : Column {
    into.add(new Divider());
    into.add(new Eyebrow(name, Tone::Neutral));
    return new Column(FlexProps { gap: 8.0, align: Align::Stretch, width: Length::Fill, capacity: 16 });
}

/** The endpoint the grid has picked, said in full. */
pub fn endpoint(ss : Shared<Session>) : dyn Widget {
    // The scrollbar sits over the right edge of what it scrolls, so the content leaves it room.
    let col : Column = new Column(FlexProps {
        gap: 14.0,
        align: Align::Stretch,
        padding: Insets { right: BAR_ROOM },
        width: Length::Fill,
        capacity: 24,
    });
    let s : i32 = actions::pickedEndpoint(ss);
    if (s < 0) {
        col.add(new Label("That endpoint has expired from the journal.", TextRole::Dim));
        return col;
    }

    col.add(summary(ss, s));

    let conn : Column = section(col, "Connection");
    connection(conn, ss, s);
    col.add(conn);

    if (ss.w.eps.host[s as i64] >= 0) {
        let who : Column = section(col, "Attribution");
        attribution(who, ss, s);
        col.add(who);
    }

    let again : Column = section(col, "Repetition");
    repetition(again, ss, s);
    col.add(again);

    let moved : Column = section(col, "Traffic");
    traffic(moved, ss, s);
    col.add(moved);

    col.add(new Divider());
    col.add(trust(ss, s));
    col.add(footer(ss));
    return new Tall(SHEET_CHROME, new Scroll(ScrollProps { height: Length::Fill }, col));
}

/** The protocol and address, the program, and the score — the one figure the rest of the sheet exists to justify. */
fn summary(ss : Shared<Session>, s : i32) : dyn Widget {
    let w : World = ss.w;
    let e : Endpoints = w.eps;
    let h : i32 = e.host[s as i64];
    let gi : i32 = e.group[s as i64];
    let named : bool = h >= 0 && w.hostName(h).some();

    let line : Row = new Row(FlexProps { gap: 10.0, align: Align::Center });
    line.add(new Tag(TagProps { text: kindBadge(e.kind[s as i64], e.proto[s as i64]), tone: Tone::Info, size: BadgeSize::Sm }));
    if (named) {
        line.add(new Label(addrText(ss, s), TextRole::Dim));
    }

    if (gi >= 0 && w.groupName(gi).some()) {
        line.add(new Label(text::spanText(w.groupName(gi)), TextRole::Dim));
    }

    let score : i32 = e.score[s as i64];
    let mut verdict : string = "not scored yet";
    if (score >= 0) {
        ss.a.scratch.reset();
        fmt::outOfFive(ss.a.scratch, score);
        verdict = text::scratchText(ss.a.scratch);
    }

    let right : dyn Widget[] = [new Label("trust", TextRole::Caption), new Label(verdict, TextRole::H3), new ScoreMeter(score)];
    let kids : dyn Widget[] = [line, new Spacer(1.0), new Column(FlexProps { gap: 4.0, align: Align::End }, right)];
    return new Row(FlexProps { gap: 12.0, align: Align::Center, width: Length::Fill }, kids);
}

/** What the socket is doing, and which program holds it. */
fn connection(into : Column, ss : Shared<Session>, s : i32) : void {
    let w : World = ss.w;
    let e : Endpoints = w.eps;
    if (e.kind[s as i64] == SocketKind::Udp) {
        fact(into, "state", "bound; Windows records no peer for UDP");
    } else if (e.liveNow[s as i64] > 0 || e.sockets[s as i64] > 0) {
        fact(into, "state", stateName(e.state[s as i64]));
    } else {
        fact(into, "state", "no socket open now; kept as history");
    }

    // The path when Windows gave one; the name it was grouped by otherwise.
    let gi : i32 = e.group[s as i64];
    if (gi >= 0) {
        fact(into, "program", text::spanText(w.groupPath(gi)));
    }
}

/** Who owns the address, and where the name came from. */
fn attribution(into : Column, ss : Shared<Session>, s : i32) : void {
    let w : World = ss.w;
    let h : i32 = w.eps.host[s as i64];
    let hosts : Hosts = w.hosts;
    fact(into, "network", text::spanText(w.network(h)));
    fact(into, "operator", text::spanText(w.operator(h)));
    fact(into, "city", text::spanText(w.city(h)));
    fact(into, "country", text::spanText(w.country(h)));
    fact(into, "flags", flagWords(hosts, h));

    let mut reach : string = reachWord(hosts.reach[h as i64]);
    if (w.eps.kind[s as i64] == SocketKind::Listen && hosts.reach[h as i64] == Reach::None) {
        reach = "every interface of this machine";
    }

    fact(into, "reach", reach);
    fact(into, "name from", nameSource(hosts.nameFrom[h as i64]));
    fact(into, "lookup", lookNote(hosts.look[h as i64]));
}

/** What the lookup service said about the kind of network, in words. */
fn flagWords(hosts : Hosts, h : i32) : string {
    let mut s : string = "";
    if (hosts.has(h, FLAG_PROXY)) {
        s = "proxy, VPN or Tor exit";
    }

    if (hosts.has(h, FLAG_HOSTING)) {
        s = text::joined(s, "datacenter");
    }

    if (hosts.has(h, FLAG_MOBILE)) {
        s = text::joined(s, "mobile carrier");
    }

    return s;
}

/** How often it came back, and how evenly. */
fn repetition(into : Column, ss : Shared<Session>, s : i32) : void {
    let e : Endpoints = ss.w.eps;
    fact(into, "visits", text::count(e.hits[s as i64]));

    if (hasRhythm(e.rhythm, s)) {
        let regular : i32 = e.rhythm.regular[s as i64];

        ss.a.scratch.reset();
        ss.a.scratch.elapsed(e.rhythm.periodMs[s as i64]);
        fact(into, "typical gap", text::scratchText(ss.a.scratch));

        ss.a.scratch.reset();
        ss.a.scratch.elapsed(e.rhythm.jitterMs[s as i64]);
        fact(into, "wander", text::scratchText(ss.a.scratch));

        fact(into, "steadiness", text::count(regular / 10) + "%  " + regularityWord(regular));
    } else {
        fact(into, "rhythm", "too few visits to read one");
    }

    ss.a.scratch.reset();
    ss.a.scratch.elapsed(e.lastMs[s as i64] - e.firstMs[s as i64] + 1);
    fact(into, "known for", text::scratchText(ss.a.scratch));
    fact(into, "sockets now", text::count(e.sockets[s as i64]));
}

/** What moved, or why nothing is known about what moved. */
fn traffic(into : Column, ss : Shared<Session>, s : i32) : void {
    let e : Endpoints = ss.w.eps;
    if (!ss.mach.tiers.bytesMeasured()) {
        into.add(new Label(
            LabelProps { role: TextRole::Dim, wrap: true },
            "Not measured. Byte counts need a kernel trace, which is not running here. Blank means unmeasured, not idle."
        ));
        return;
    }

    // The trace counts bytes per process, not per socket. The program's row
    // is the finest reading it gives, so that is what the card shows — and
    // it says so, rather than presenting a program total as this socket's.
    let g : Groups = ss.w.groups;
    let gi : i32 = e.group[s as i64];
    if (!g.measured(gi)) {
        into.add(new Label(
            LabelProps { role: TextRole::Dim, wrap: true },
            "The kernel trace is running and has not counted bytes for this program yet."
        ));
        return;
    }

    ss.a.scratch.reset();
    ss.a.scratch.byteCount(g.traceIn[gi as i64]);
    fact(into, "received, program", text::scratchText(ss.a.scratch));

    ss.a.scratch.reset();
    ss.a.scratch.byteCount(g.traceOut[gi as i64]);
    fact(into, "sent, program", text::scratchText(ss.a.scratch));

    ss.a.scratch.reset();
    fmt::rate(ss.a.scratch, g.rate(gi));
    fact(into, "now, program", text::scratchText(ss.a.scratch));

    into.add(new Label(
        LabelProps { role: TextRole::Caption, wrap: true },
        "The trace counts bytes per program; this connection's share is not split out."
    ));
}

/**
 * The score, taken apart. Every signal that applied is listed with what it
 * cost or earned; the ones that did not apply are left out rather than shown
 * at zero, because a list of twenty zeroes hides the three lines that matter.
 */
fn trust(ss : Shared<Session>, s : i32) : dyn Widget {
    let e : Endpoints = ss.w.eps;
    let score : i32 = e.score[s as i64];
    if (score < 0) {
        let kids : dyn Widget[] = [
            new Eyebrow("Trust", Tone::Neutral),
            new Label("Nothing is known about this address yet. A score now would be a number with no evidence behind it.", TextRole::Dim),
        ];
        return new Column(FlexProps { gap: 8.0, align: Align::Stretch }, kids);
    }

    let mut n : i32 = 0;
    for (i of 0..REASON_COUNT) {
        if ((e.reasons[s as i64] & reasonBit(reasonAt(i))) != 0) {
            n = n + 1;
        }
    }

    if (n == 0) {
        let kids : dyn Widget[] = [
            new Eyebrow("Trust", Tone::Neutral),
            new Label("No signal applies. The burden is on the evidence, so it scores five.", TextRole::Dim),
        ];
        return new Column(FlexProps { gap: 8.0, align: Align::Stretch }, kids);
    }

    let mut signals : Reason[] = malloc<Reason>(n as i64);
    let mut at : i32 = 0;
    for (i of 0..REASON_COUNT) {
        let r : Signal = reasonAt(i);
        if ((e.reasons[s as i64] & reasonBit(r)) == 0) {
            continue;
        }

        let weight : i32 = reasonWeight(r);
        let mut tone : Tone = Tone::Danger;
        if (weight > 0) {
            tone = Tone::Ok;
        }

        signals[at as i64] = Reason { weight: signed(weight), text: reasonText(r), tone: tone };
        at = at + 1;
    }

    return new ReasonList(ReasonProps { title: "Trust" }, signals);
}

/** A weight in tenths, with its sign. */
fn signed(tenths : i32) : string {
    let sb : StringBuilder = new StringBuilder();
    if (tenths < 0) {
        sb.append("−");
    } else {
        sb.append("+");
    }

    let magnitude : i32 = tenths.abs();
    sb.appendI32(magnitude / 10);
    sb.append(".");
    sb.appendI32(magnitude % 10);
    return sb.toString();
}

/** The action the sheet offers: the program's folder. */
fn footer(ss : Shared<Session>) : dyn Widget {
    let hand : Shared<Session> = ss;
    let kids : dyn Widget[] = [
        new Button(
            ButtonProps { label: "Open the program's folder", kind: ButtonKind::Outline, icon: IconKind::Folder },
            () => actions::open(hand)
        ),
    ];
    return new Row(FlexProps { gap: 8.0, align: Align::Center }, kids);
}

// ─── The keyboard ────────────────────────────────────────────

/** A heading and its keys. */
fn keys(into : Column, name : string, terms : string[], details : string[]) : void {
    into.add(new Eyebrow(name, Tone::Neutral));
    into.add(new DescriptionList(terms, details));
}

/** Everything the window answers to. The pointer does the rest. */
pub fn help() : dyn Widget {
    let col : Column = new Column(FlexProps { gap: 16.0, align: Align::Stretch, width: Length::Fill, capacity: 12 });

    let moving : string[] = ["Up / Down", "PgUp / PgDn", "Right / Left", "8", "Enter"];
    let movingDo : string[] = [
        "move between rows",
        "move by a screen; Home and End go to the ends",
        "open and fold a program",
        "fold or open every program",
        "details of an endpoint; fold, on a program",
    ];
    keys(col, "Moving", moving, movingDo);

    let shown : string[] = ["S", "L", "B", "/"];
    let shownDo : string[] = [
        "next ranking; Sort lists them all",
        "also show traffic that stays on this machine or network",
        "also show listening sockets and UDP handles",
        "filter by program, host, network or address",
    ];
    keys(col, "What is shown", shown, shownDo);

    let doing : string[] = ["O", "C", "P / Space", "R / F5", "F1 / ?", "F12", "Esc", "Q"];
    let doingDo : string[] = [
        "open the folder holding the program",
        "clear the history back to what is live",
        "pause and resume",
        "re-read the machine now",
        "this list",
        "write the window to netaudit.bmp",
        "close this, clear the filter",
        "quit",
    ];
    keys(col, "Doing", doing, doingDo);
    return col;
}
