// app — the interaction state: what is filtered, ranked, revealed, picked, and
// what the window is currently saying.
//
// Deliberately separate from the model: `model/*` is what the machine
// reports, this is what the reader is doing to it.
//
// Every value a widget shows or edits is a Zaffre `Model` held here, so a
// control and the program read one value and nothing is synchronised by hand.
// The selection is the grid's own `DataState`, held as a **key**, never as a
// row index or a slot — the tree is rebuilt from scratch every tick, and an
// index would quietly come to mean a different endpoint.
//
// `holdOrder` is the other half of the stability contract: while the pointer
// is over the rows, and for a moment after it leaves, no reordering happens at
// all, so nothing moves under a reader's hand between seeing a row and
// clicking it.

use smalt::{Scratch, Mem};
use zaffre::{Model, DataState};
use crate::model::view::{Sort, SORT_COUNT, sortAt, Lens};

/** Bytes of the filter the model's matcher reads. */
const FILTER_CAP : i32 = 64;
/** Bytes of the formatting scratch — one figure at a time. */
const SCRATCH_CAP : i64 = 512;

/** How long a status message stays up, in refresh ticks. */
const SAY_TICKS : i32 = 4;

/**
 * How long reordering stays frozen after the pointer leaves the rows. The
 * reader may be reaching for the scrollbar or the toolbar and still be
 * reading the rows.
 */
const FREEZE_TAIL_MS : i64 = 2000;

/**
 * What the status bar is saying.
 *
 * A message rather than a string, because two of them read differently
 * depending on what they toggled — `sayText` is the one place that decides,
 * and it is a `match`, so a message added here cannot ship without its
 * sentence.
 */
enum Say : i32 {
    /** Nothing is being said. */
    None = 0,
    /** The folder holding the selected program was opened. */
    Opened = 1,
    /** Windows would not open the folder — usually a path it refused to give. */
    NoPath = 2,
    /** Refreshing is paused. */
    Paused = 3,
    /** Refreshing has resumed. */
    Resumed = 4,
    /** Loopback rows were revealed or hidden. */
    Local = 5,
    /** Listening and UDP sockets were revealed or hidden. */
    Bound = 6,
    /** The journal was cleared back to what is live now. */
    Cleared = 7,
    /** The window was written to a file. */
    Snapped = 8,
    /** It could not be. */
    NoSnap = 9,
}

/** The state of the window, whole. */
class App {
    /** The filter field's text. */
    pub(crate) query : Shared<Model<string>> = new shared Model<string>("");
    /** The ranking, as a place in the `S` key's cycle. */
    pub(crate) ranking : Shared<Model<i32>> = new shared Model<i32>(0);
    /** Whether traffic that never leaves the building is shown. */
    pub(crate) showLocal : Shared<Model<bool>> = new shared Model<bool>(false);
    /** Whether listening sockets and UDP handles are shown. */
    pub(crate) showBound : Shared<Model<bool>> = new shared Model<bool>(false);
    /** How many rows each of those two is hiding. */
    pub(crate) localCount : Shared<Model<i32>> = new shared Model<i32>(0);
    pub(crate) boundCount : Shared<Model<i32>> = new shared Model<i32>(0);
    /** The line the status bar shows. */
    pub(crate) status : Shared<Model<string>> = new shared Model<string>("");
    /** What the reader has done to the grid: the pick, the scroll, the pointer over it. */
    pub(crate) grid : Shared<DataState> = new shared DataState();
    /** Whether the dark theme is on. */
    pub(crate) dark : Shared<Model<bool>> = new shared Model<bool>(true);
    /** Goes up once per reading and whenever a program is folded, so the grid knows its rows are stale. */
    pub(crate) rev : i64 = 0;
    /** Goes up on every refresh, for the pieces that are rebuilt from the model. */
    pub(crate) stamp : Shared<Model<i64>> = new shared Model<i64>(0);

    /** The filter's bytes, as the model's matcher reads them. */
    pub(crate) filter : i64 = Mem::take(FILTER_CAP as i64);
    pub(crate) filterLen : i32 = 0;

    pub(crate) quitting : bool = false;
    pub(crate) refreshDue : bool = false;
    pub(crate) paused : bool = false;
    /** The keyboard reference was asked for; the root opens it at its next tick. */
    pub(crate) helpAsked : bool = false;
    /** A snapshot was asked for; the loop writes it after the next frame. */
    pub(crate) snapDue : bool = false;
    /** The time of the loop's last turn, in milliseconds since it began. */
    pub(crate) nowMs : i64 = 0;
    freezeUntilMs : i64 = 0;

    pub(crate) scratch : Scratch = new Scratch(SCRATCH_CAP);
    pub(crate) say : Say = Say::None;
    sayLeft : i32 = 0;

    /** Whether reordering is currently suspended. */
    pub(crate) fn frozen(self) : bool {
        return self.nowMs < self.freezeUntilMs;
    }

    /** Hold the order still, because the pointer is over the rows. */
    pub(crate) fn holdOrder(mut self) : void {
        self.freezeUntilMs = self.nowMs + FREEZE_TAIL_MS;
    }

    /** Let the order move again at the next rebuild. */
    pub(crate) fn releaseOrder(mut self) : void {
        self.freezeUntilMs = 0;
    }

    /** The ranking the reader has chosen. */
    pub(crate) fn sortKey(self) : Sort {
        return sortAt(self.ranking.get());
    }

    /** Copy the filter's text into the bytes the matcher reads. */
    pub(crate) fn takeQuery(mut self) : void {
        let text : string = self.query.get();
        let mut n : i32 = text.byteLength as i32;
        if (n > FILTER_CAP) {
            n = FILTER_CAP;
        }

        for (i of 0..n) {
            Mem::putByte(self.filter, i as i64, text.byteAt(i as i64));
        }

        self.filterLen = n;
    }

    /** What the rows should show now, as the model reads it. */
    pub(crate) fn lens(mut self) : Lens {
        self.takeQuery();
        return Lens {
            needle: self.filter,
            needleLen: self.filterLen,
            sortKey: self.sortKey(),
            showLocal: self.showLocal.get(),
            showBound: self.showBound.get(),
            freeze: self.frozen(),
        };
    }

    /**
     * A number that differs whenever the rows may have changed. Every part
     * of it only ever goes up, so the sum is equal exactly when none of them
     * moved.
     */
    pub(crate) fn signature(self) : i64 {
        return self.rev + self.query.changes() + self.ranking.changes()
            + self.showLocal.changes() + self.showBound.changes();
    }

    /** Move to the next ranking, wrapping. */
    pub(crate) fn nextSort(mut self) : void {
        self.ranking.set((self.ranking.get() + 1) % SORT_COUNT);
    }

    /** Show or hide traffic that never leaves the building, and say which. */
    pub(crate) fn flipLocal(mut self) : void {
        self.showLocal.set(!self.showLocal.get());
        self.saying(Say::Local);
    }

    /** Show or hide listening sockets and UDP handles, and say which. */
    pub(crate) fn flipBound(mut self) : void {
        self.showBound.set(!self.showBound.get());
        self.saying(Say::Bound);
    }

    /** Pause or resume the readings. */
    pub(crate) fn flipPause(mut self) : void {
        self.paused = !self.paused;
        if (self.paused) {
            self.saying(Say::Paused);
        } else {
            self.saying(Say::Resumed);
        }

        self.stamp.set(self.stamp.get() + 1);
    }

    /** Put a message in the status bar for the next few refresh ticks. */
    pub(crate) fn saying(mut self, what : Say) : void {
        self.say = what;
        self.sayLeft = SAY_TICKS;
        self.status.set(sayText(what, self.showLocal.get(), self.showBound.get()));
    }

    /** The reader asked to close the window. */
    pub(crate) fn quit(mut self) : void {
        self.quitting = true;
    }

    /**
     * Re-read the machine at the next turn of the loop rather than at the
     * next tick.
     *
     * A flag and not a deadline: the loop owns the clock, and a caller that
     * could write the deadline could also write one in the past by accident
     * and spin the machine.
     */
    pub(crate) fn refreshNow(mut self) : void {
        self.refreshDue = true;
    }

    /** Age the status message; called once per refresh tick. */
    pub(crate) fn tick(mut self) : void {
        self.rev = self.rev + 1;
        self.stamp.set(self.stamp.get() + 1);
        if (self.sayLeft > 0) {
            self.sayLeft = self.sayLeft - 1;
            if (self.sayLeft == 0) {
                self.say = Say::None;
            }
        }
    }

    /** Release the two raw buffers. */
    pub(crate) fn dispose(mut self) : void {
        if (self.filter != 0) {
            Mem::release(self.filter);
            self.filter = 0;
        }

        self.scratch.close();
    }
}

/** The status-bar line for `say`, empty when there is nothing to report. */
fn sayText(say : Say, showLocal : bool, showBound : bool) : string {
    return match say {
        Say::None => "",
        Say::Opened => "Opened the folder holding that program.",
        Say::NoPath =>
            "Windows gave no path for that program, or Explorer refused it.",
        Say::Paused => "Paused. The journal is frozen until Space resumes it.",
        Say::Resumed => "Live again.",
        Say::Cleared => "History cleared back to what is live now.",
        Say::Snapped => "Window written to netaudit.bmp, in the folder it was started from.",
        Say::NoSnap => "Could not write netaudit.bmp; the folder may be read-only.",
        // The two toggles say which way they went, so each carries both
        // sentences: a message that only said "local traffic" would leave a
        // reader to check the row count to find out what just happened.
        Say::Local => match showLocal {
            true => "Showing traffic that stays on this machine and this network.",
            false => "Hiding traffic that stays on this machine and this network.",
        },
        Say::Bound => match showBound {
            true => "Showing listening sockets and UDP handles; neither has a peer.",
            false => "Hiding listening sockets and UDP handles.",
        },
    };
}

/** The name of a ranking as a title, as the ranking menu lists it. */
fn sortTitle(key : Sort) : string {
    return match key {
        Sort::Salience => "Salience",
        Sort::Traffic => "Traffic",
        Sort::Risk => "Risk",
        Sort::Rhythm => "Rhythm",
        Sort::Hits => "Repeats",
        Sort::Name => "Name",
        Sort::Recent => "Last seen",
    };
}

/**
 * What the active sort is actually ranking by, in one line. A reader who
 * does not know what "salience" weighs cannot trust the order, and an order
 * nobody trusts gets ignored.
 */
fn sortNote(key : Sort) : string {
    return match key {
        Sort::Salience => "repeats, rhythm, risk, traffic and recency, weighted",
        Sort::Traffic => "most bytes moving first",
        Sort::Risk => "worst trust score first; unknown addresses last",
        Sort::Rhythm => "steadiest repeat interval first: the shape a timer makes",
        Sort::Hits => "most repeat visits first",
        Sort::Name => "by host name, A to Z",
        Sort::Recent => "most recently seen first",
    };
}
