// enrich/ipapi — turning one batch response into rows.
//
// The response is an array of flat objects, one per address, **in the order
// they were asked for**. That ordering is the whole mechanism: an answer
// finds its row by position, not by parsing the returned address back into
// bytes and looking it up. The returned `query` is still compared against
// the address the row holds, because a service that reorders its answers
// once would otherwise attribute every network in the batch to the wrong
// program, silently and forever.
//
// Nothing that arrives here survives as a `string`. Each value is a byte
// range in the response, copied straight into the pool, and the response is
// dropped whole at the end of the call.

use smalt::{Scratch, Mem};
use crate::enrich::scan;
use crate::enrich::queue;
use crate::model::hosts::{Hosts, Look, NameSource, HOST_MAX, ORG_MAX, PLACE_MAX};
use crate::model::hosts::{FLAG_PROXY, FLAG_HOSTING, FLAG_MOBILE};
use crate::model::pool::Pool;
use crate::model::world::World;
use crate::fmt;

/**
 * One object of the response: the body it sits in, and where it starts and
 * ends. Every reader below takes this one value instead of the same four
 * arguments in the same order.
 */
struct Obj {
    /** The whole response. */
    pub(crate) body : string;
    /** The object's opening brace. */
    pub(crate) from : i64;
    /** Just past its closing brace. */
    pub(crate) to : i64;
    /** The body's length, the bound every scan is held to. */
    pub(crate) len : i64;
}

/**
 * Fold a batch response into the rows it answers for. `true` when at least
 * one row learned something — a response that parses but answers for nothing
 * is a failure the caller should back off from, not a success with no effect.
 */
fn absorb(q : Queue, w : World, body : string, s : Scratch) : bool {
    let len : i64 = body.byteLength;
    let at : i64 = 0;
    let i : i32 = 0;
    let landed : i32 = 0;

    while (i < q.sentLen) {
        let from : i64 = scan::objectStart(body, at, len);
        if (from < 0) {
            i = q.sentLen;
        } else {
            let o : Obj = Obj {
                body: body,
                from: from,
                to: scan::objectEnd(body, from, len),
                len: len,
            };
            let h : i32 = q.sent[i];
            if (h >= 0 && verifies(o, w.hosts, h, s)) {
                one(o, w, h);
                landed = landed + 1;
            }

            at = o.to;
            i = i + 1;
        }
    }

    // What the response did not cover is left `Sent`, for the caller to
    // settle: `Queue::succeeded` marks it failed when the batch as a whole
    // answered, and `Queue::failed` puts it back in line when it did not. A
    // body that never arrived must not be read as "every address in it came
    // back empty" — that is a network that was down, not a verdict.
    q.resolved = q.resolved + landed;
    return landed > 0;
}

/** Where the value of `key` starts in `o`, or `-1`. */
fn valueOf(o : Obj, key : string) : i64 {
    return scan::valueStart(o.body, scan::field(o.body, o.from, o.to, key), o.len);
}

/** Just past the end of the value of `key` in `o`, or `-1`. */
fn valueEndOf(o : Obj, key : string) : i64 {
    return scan::valueEnd(o.body, scan::field(o.body, o.from, o.to, key), o.len);
}

/**
 * Whether the object's `query` really is the address row `h` holds. The
 * comparison is against the same formatting the request was built from, so
 * the two sides cannot disagree about how an address is spelled.
 */
fn verifies(o : Obj, hosts : Hosts, h : i32, s : Scratch) : bool {
    let vs : i64 = valueOf(o, "query");
    let ve : i64 = valueEndOf(o, "query");
    if (vs < 0 || ve <= vs) {
        return false;
    }

    s.reset();
    fmt::address(s, hosts.addrAt(h), hosts.family[h]);
    if (ve - vs != (s.length() as i64)) {
        return false;
    }

    for (i of 0..s.length()) {
        if (o.body.byteAt(vs + (i as i64)) != Mem::byteAt(s.at(), i as i64)) {
            return false;
        }
    }

    return true;
}

/** Fold one object into row `h`. */
fn one(o : Obj, w : World, h : i32) : void {
    let hosts : Hosts = w.hosts;
    if (!succeeded(o)) {
        hosts.look[h] = Look::Failed;
        return;
    }

    network(o, w, h);

    hosts.orgOff[h] = intern(o, w.pool, "isp", ORG_MAX);
    hosts.orgLen[h] = lenOf(w.pool, hosts.orgOff[h]);
    hosts.countryOff[h] = intern(o, w.pool, "country", PLACE_MAX);
    hosts.countryLen[h] = lenOf(w.pool, hosts.countryOff[h]);
    hosts.ccOff[h] = intern(o, w.pool, "countryCode", 2);
    hosts.ccLen[h] = lenOf(w.pool, hosts.ccOff[h]);
    hosts.cityOff[h] = intern(o, w.pool, "city", PLACE_MAX);
    hosts.cityLen[h] = lenOf(w.pool, hosts.cityOff[h]);

    let name : i64 = intern(o, w.pool, "reverse", HOST_MAX);
    hosts.name(h, name, lenOf(w.pool, name), NameSource::Ptr);

    flag(o, hosts, h, "proxy", FLAG_PROXY);
    flag(o, hosts, h, "hosting", FLAG_HOSTING);
    flag(o, hosts, h, "mobile", FLAG_MOBILE);

    hosts.look[h] = Look::Done;
}

/** Whether the object's `status` is `success`. */
fn succeeded(o : Obj) : bool {
    let vs : i64 = valueOf(o, "status");
    if (vs < 0) {
        return false;
    }

    return scan::matches(o.body, vs, o.len, "success");
}

/**
 * The owning network, which is the field this program most wants and the one
 * the service spells most awkwardly: `as` arrives as `AS15169 Google LLC` —
 * a number and a name in one string. Both are wanted, and separately: the
 * number keys the "how many distinct networks" card and the well-known-network
 * check, and the name is what a reader actually recognises.
 *
 * So the whole string is interned as the network's label, and the digits
 * after the `AS` are read off for the number. When the service returns it
 * empty — which it does for addresses inside a registry it cannot see —
 * `asname` is taken instead, and the row says the number it has and no more.
 */
fn network(o : Obj, w : World, h : i32) : void {
    let hosts : Hosts = w.hosts;
    let vs : i64 = valueOf(o, "as");
    let ve : i64 = valueEndOf(o, "as");

    if (vs >= 0 && ve > vs) {
        hosts.netOff[h] = w.pool.putRange(o.body, vs, ve, ORG_MAX);
        hosts.netLen[h] = lenOf(w.pool, hosts.netOff[h]);
        if (scan::matches(o.body, vs, o.len, "AS")) {
            let n : i32 = scan::digits(o.body, vs + 2, o.len);
            if (n > 0) {
                hosts.asn[h] = n;
            }
        }

        return;
    }

    let off : i64 = intern(o, w.pool, "asname", ORG_MAX);
    if (off >= 0) {
        hosts.netOff[h] = off;
        hosts.netLen[h] = lenOf(w.pool, off);
    }
}

/** Intern the string value of `key`, or `-1` when it is absent or empty. */
fn intern(o : Obj, pool : Pool, key : string, max : i32) : i64 {
    let vs : i64 = valueOf(o, key);
    let ve : i64 = valueEndOf(o, key);
    if (vs < 0 || ve <= vs) {
        return -1;
    }

    return pool.putRange(o.body, vs, ve, max);
}

/**
 * How long the span at `off` is, read off the pool's own cursor. Valid only
 * immediately after the intern that produced `off` — which is how every
 * caller here uses it, and why the interning and the measuring sit on
 * consecutive lines rather than in two passes over the response.
 */
fn lenOf(pool : Pool, off : i64) : i32 {
    if (off < 0) {
        return 0;
    }

    return (pool.used() - off) as i32;
}

/** Raise `bit` on row `h` when the object's `key` is `true`. */
fn flag(o : Obj, hosts : Hosts, h : i32, key : string, bit : i32) : void {
    if (scan::isTrue(o.body, scan::field(o.body, o.from, o.to, key), o.len)) {
        hosts.raise(h, bit);
    }
}
