// netaudit — what every program on this machine is talking to.
//
//   session      the loop's state, whole: the model, the machine, the
//                lookup queue, and what the reader is doing
//   sys/machine  the readings: the process list and socket table gesso
//                answers, the resolver's cache, the kernel trace, and which
//                of the three readings are running
//   sys/*        the folds from gesso's readings into the journal's columns:
//                sockets, processes, cached names, and per-process bytes
//   model/world  the journal: endpoints, their programs, their addresses,
//                their rhythm, their score, and the flattened tree
//   app          what the reader is doing to it
//   ui/*         the window, built from Zaffre's components: a grid over the
//                journal, key figures, a filter, a status bar, and a sheet
//                for one endpoint
//   zaffre       the widgets, the theme, the view; smalt under it is the
//                window, the surface and the event queue
//   fmt          the figures a library cannot format: an address, and the
//                readings whose empty case carries information
//
// The loop is event-driven, not frame-driven: `Events::wait` blocks in the
// OS until something arrives, an animation needs a frame, or the next reading
// is due, and the window is drawn when something changed. A tool that
// measures the machine's traffic should not be a reason to measure it.
//
// The machine is re-read once a second, and nothing a reader can see moves
// because of that: rows are keyed rather than indexed, closed conversations
// linger, the sort is damped, and reordering stops entirely while the
// pointer is over the rows.
//
// Build & run:  axle build, then target/netaudit.exe
//               (no elevation needed; elevated, service paths also read)

use smalt::{Platform, PlatformError, WindowDesc, Clock, Events, Event, EventKind as SmaltKind};
use smalt::{Surface, Bmp, MouseButton, Scancode, CursorShape};
use zaffre::{
    View, Theme, Fonts, Keys, UiEvent, EventKind, Key, Mod, Cursor, Strings,
};
use crate::ui::page;
use crate::ui::root::Root;
use crate::ui::actions;
use crate::app::{App, Say};
use crate::session::Session;
use crate::model::world::World;
use crate::model::pulse;
use crate::model::view::{Rows, RowKind};
use crate::model::score;
use crate::model::endpoints::{rank, absorbSnapshot};
use crate::model::hosts::{Hosts, NameSource, HOST_MAX, ORG_MAX, ASKED_ORIGIN};
use crate::model::addr::{Reach, netAddr};
use crate::sys::machine::Machine;
use crate::sys::tiers::TierState;
use crate::sys::traffic::{TraceReader, startTraffic};
use crate::sys::dnscache;
use gesso::{DnsCacheReader, ReadingState};
use crate::enrich::queue;
use crate::enrich::queue::{Queue, WhoisKind};
use crate::enrich::ipapi;
use crate::enrich::worker;
use std::sys::process::{argc, argAt};
use std::lang::{IndexOutOfBoundsException, ParseException};

/** The size the window opens at. */
const WIN_W : i32 = 1360;
const WIN_H : i32 = 900;
/** How often the machine is re-read, in milliseconds. */
const REFRESH_MS : i64 = 1000;
/**
 * Longest the loop blocks in the OS with nothing due.
 *
 * `Events::wait` returns as soon as anything arrives, so this is not a
 * poll interval — it is the ceiling on how long an enrichment answer sits
 * in a joined task before the loop notices it. Idle and paused, this
 * program uses no measurable CPU at all, which is the one thing a tool
 * that measures the machine owes it.
 */
const IDLE_MS : i32 = 250;
/** The wait while something animates: about a frame. */
const FRAME_MS : i32 = 16;
/** The window's caption. */
const TITLE : string = "netaudit";
/** Where a snapshot lands: the folder the program was started from. */
const SNAP_PATH : string = "netaudit.bmp";

fn main() : void {
    try {
        run();
    } catch e : PlatformError {
        println(e.message);
    }
}

/** The faces and the theme the whole window is set in. */
fn built(ss : Shared<Session>) : View {
    let fonts : Shared<Fonts> = new shared Fonts();
    return new View(Theme::dark(), fonts, ss.a.dark, new Root(ss, page::assemble(ss)));
}

fn run() : void ! PlatformError {
    let platform = new Platform();
    defer platform.close();
    let win = platform.open(WindowDesc {
        title: TITLE,
        w: WIN_W,
        h: WIN_H,
        resizable: true,
    });
    defer win.close();
    let screen = new Surface(WIN_W, WIN_H);
    defer screen.close();
    let clock = new Clock();
    defer clock.close();
    let events = new Events();
    defer events.close();

    let ss : Shared<Session> = new shared Session();
    let mut a : App = ss.a;
    // The kernel trace is a handle minted on this thread and polled by the
    // loop that owns it, like the two lookup tasks below: the type lives
    // here rather than in `Machine`, because a class stored in a
    // trait-typed field is not lowered yet.
    let mut trace : dyn TraceReader = startTraffic();
    defer trace.dispose();
    let view : View = built(ss);
    view.resize(WIN_W as f64, WIN_H as f64);

    // The two lookups in flight. They live here rather than on `Session`
    // because a `Task` is a handle minted on this thread and consumable only
    // here — parking one in a field would be parking it where the thread
    // that must join it cannot reach it.
    let mut jobs : Future<string>[2];
    jobs[0] = spawn worker::idle();
    jobs[1] = spawn worker::idle();
    await jobs[0];
    await jobs[1];

    let freq : i64 = clock.frequency();
    let start : i64 = clock.counter();
    let mut due : i64 = 0;
    // The text last mirrored to the system clipboard, so only a change is sent.
    let mut mirrored : string = "";
    let mut mx : f64 = 0.0;
    let mut my : f64 = 0.0;
    // How many presses the button made when it went down, so its release can say so: a
    // grid reads a double click off the release.
    let mut presses : i32 = 1;

    // `--snap <ms>` writes one frame and leaves. It is how a capture gets
    // into a report without someone standing over the machine at the right
    // moment, and how this window's own layout is checked without one either.
    let snapAtMs : i64 = snapDeadline();
    let pane : string = snapPane();
    let mut paned : bool = false;

    while (!a.quitting && win.isOpen()) {
        a.nowMs = ((clock.counter() - start) * 1000) / freq;
        events.wait(win, clock, waitMs(clock, view, due, freq, a.paused));
        a.nowMs = ((clock.counter() - start) * 1000) / freq;

        while (events.hasNext()) {
            let e : Event = events.next();
            match e.kind {
                SmaltKind::Quit => {
                    a.quit();
                },
                SmaltKind::WindowResized => {
                    if (e.width > 0 && e.height > 0) {
                        screen.resize(e.width, e.height);
                        view.resize(e.width as f64, e.height as f64);
                    }
                },
                SmaltKind::MouseMotion => {
                    mx = e.x as f64;
                    my = e.y as f64;
                    view.input(UiEvent { kind: EventKind::PointerMove, x: mx, y: my, mods: modsOf(events) });
                },
                SmaltKind::MouseButtonDown => {
                    mx = e.x as f64;
                    my = e.y as f64;
                    presses = e.clicks;
                    view.input(UiEvent { kind: EventKind::PointerDown, x: mx, y: my, button: buttonOf(e.button), clicks: e.clicks, mods: modsOf(events) });
                },
                SmaltKind::MouseButtonUp => {
                    mx = e.x as f64;
                    my = e.y as f64;
                    view.input(UiEvent { kind: EventKind::PointerUp, x: mx, y: my, button: buttonOf(e.button), clicks: presses, mods: modsOf(events) });
                },
                SmaltKind::MouseWheel => {
                    view.input(UiEvent { kind: EventKind::Wheel, x: mx, y: my, wheel: e.wheel as f64, mods: modsOf(events) });
                },
                SmaltKind::MouseLeft => {
                    view.input(UiEvent { kind: EventKind::PointerLeave });
                },
                SmaltKind::KeyDown => {
                    // A paste reads the system clipboard as it is now, not as it was when it was last copied here.
                    if (Keys::key(e.scancode) == Key::V && (modsOf(events) & Mod::CTRL) != 0) {
                        view.setClipboard(win.clipboardText());
                        mirrored = view.clipboard();
                    }

                    // The keys the library has no name for.
                    if (!fnKey(a, e.scancode)) {
                        view.input(UiEvent { kind: EventKind::KeyDown, key: Keys::key(e.scancode), mods: modsOf(events), repeat: e.repeat });
                    }
                },
                SmaltKind::KeyUp => {
                    view.input(UiEvent { kind: EventKind::KeyUp, key: Keys::key(e.scancode), mods: modsOf(events) });
                },
                SmaltKind::TextInput => {
                    view.input(UiEvent { kind: EventKind::Text, cp: e.text, mods: modsOf(events) });
                },
                SmaltKind::WindowFocusLost => {
                    view.input(UiEvent { kind: EventKind::WindowBlur });
                },
                _ => {
                },
            }
        }

        // What a field copied goes to the system clipboard; the pointer takes the shape asked for.
        if (view.clipboard() != mirrored) {
            mirrored = view.clipboard();
            win.setClipboardText(mirrored);
        }

        win.setCursor(shapeOf(view.cursor()));

        // Each step runs every turn; only then is it asked whether any of
        // them changed what is on screen.
        let landed : bool = collect(ss, a.nowMs, jobs);
        let named : bool = sweepDns(ss, a.nowMs);
        if (landed || named) {
            a.stamp.set(a.stamp.get() + 1);
            page::refreshStatus(ss);
            view.invalidate();
        }

        dispatch(ss, a.nowMs, jobs);

        let now : i64 = clock.counter();
        if (!a.paused && (a.refreshDue || now >= due)) {
            a.refreshDue = false;
            refresh(ss, a.nowMs, trace);
            a.tick();
            page::refreshStatus(ss);
            view.invalidate();
            due = now + (freq * REFRESH_MS) / 1000;
        }

        // A capture of a sheet opens it halfway to the deadline, so the slide has finished.
        if (snapAtMs > 0 && !paned && a.nowMs >= snapAtMs / 2) {
            paned = true;
            if (pane == "help") {
                a.helpAsked = true;
            } else if (pane == "detail") {
                openFirstEndpoint(ss);
            } else if (pane.byteLength > 5 && Strings::slice(pane, 0, 5) == "keys:") {
                feed(view, Strings::slice(pane, 5, pane.byteLength));
            }
        }

        view.update((a.nowMs as f64) / 1000.0);
        if (view.needsFrame() && !win.minimised()) {
            view.render(screen.frame());
            screen.present(win);
        }

        if (a.snapDue || (snapAtMs > 0 && a.nowMs >= snapAtMs)) {
            let wrote : bool = Bmp::write(SNAP_PATH, screen.frame());
            if (snapAtMs > 0) {
                a.quit();
            } else {
                a.snapDue = false;
                if (wrote) {
                    a.saying(Say::Snapped);
                } else {
                    a.saying(Say::NoSnap);
                }

                view.invalidate();
            }
        }
    }

    drain(ss.q, jobs);
    ss.dispose();
}

/**
 * How long the loop may block before something is owed.
 *
 * Animating, a frame; with a change waiting, none; otherwise the sooner of
 * the view's next timed wake (a caret to blink) and the next reading. Paused,
 * no reading is due and the ceiling is the whole of it. A reading is never
 * late by more than the time the OS took to wake the thread, and the loop
 * still sleeps through every millisecond between two of them.
 */
fn waitMs(clock : Clock, view : View, due : i64, freq : i64, paused : bool) : i32 {
    if (view.isAnimating()) {
        return FRAME_MS;
    }

    if (view.isDirty()) {
        return 0;
    }

    let mut wait : i32 = IDLE_MS;
    let wake : f64 = view.waitSeconds() * 1000.0;
    if (wake < (wait as f64)) {
        wait = wake.ceilToInt() as i32;
    }

    if (!paused) {
        let left : i64 = ((due - clock.counter()) * 1000) / freq;
        if (left <= 0) {
            return 0;
        }

        if (left < (wait as i64)) {
            wait = left as i32;
        }
    }

    return wait;
}

/**
 * The function keys, which the library does not name. Answers whether the key
 * was one of them and has been dealt with.
 */
fn fnKey(a : App, sc : Scancode) : bool {
    if (sc == Scancode::F1) {
        a.helpAsked = true;
        return true;
    }

    if (sc == Scancode::F5) {
        a.refreshNow();
        return true;
    }

    if (sc == Scancode::F12) {
        a.snapDue = true;
        return true;
    }

    return false;
}

/** The modifier bits that are down now. */
fn modsOf(events : Events) : i32 {
    let mut m : i32 = 0;
    if (events.isKeyDown(Scancode::LeftShift) || events.isKeyDown(Scancode::RightShift)) {
        m = m | Mod::SHIFT;
    }

    if (events.isKeyDown(Scancode::LeftControl) || events.isKeyDown(Scancode::RightControl)) {
        m = m | Mod::CTRL;
    }

    if (events.isKeyDown(Scancode::LeftAlt) || events.isKeyDown(Scancode::RightAlt)) {
        m = m | Mod::ALT;
    }

    return m;
}

/** The window's pointer shape for what a widget asked for. */
fn shapeOf(c : Cursor) : CursorShape {
    return match c {
        Cursor::Hand => CursorShape::Hand,
        Cursor::Beam => CursorShape::Beam,
        Cursor::ResizeH => CursorShape::ResizeH,
        Cursor::ResizeV => CursorShape::ResizeV,
        Cursor::Wait => CursorShape::Wait,
        Cursor::NotAllowed => CursorShape::NotAllowed,
        Cursor::Move => CursorShape::Move,
        _ => CursorShape::Arrow,
    };
}

/** The library's number for smalt's mouse button. */
fn buttonOf(b : MouseButton) : i32 {
    return match b {
        MouseButton::Left => 0,
        MouseButton::Right => 1,
        MouseButton::Middle => 2,
        _ => 3,
    };
}

/**
 * Read the resolver's cache when a sweep is due, and set its badge. Answers
 * whether a name landed on screen.
 *
 * The badge is off when the reader could not be set up at all, and lost while
 * the cache answers nothing — which an empty cache also does.
 */
fn sweepDns(ss : Shared<Session>, nowMs : i64) : bool {
    let dns : DnsCacheReader = ss.mach.dns;
    let mut learned : bool = false;
    if (!ss.a.paused && dns.due(nowMs)) {
        learned = dnscache::sweep(dns, ss.w.hosts, ss.w.pool, nowMs);
    }

    // The reader says which of on / off / lost it is, and why; the window's
    // three states are that answer with the same names.
    ss.mach.tiers.dns = match dns.status().state {
        ReadingState::On => TierState::On,
        ReadingState::Lost => TierState::Lost,
        ReadingState::Off => TierState::Off,
    };

    return learned;
}

/**
 * Take in whatever the two lookups have finished, and answer whether
 * anything on screen changed.
 *
 * `isAlive` is a peek, not a wait: it is asked every frame and costs
 * nothing, and `join` is only reached once the worker has already returned.
 * A worker that could not reach its service answers with an empty body,
 * which every reader below treats as "did not answer" — see `enrich/worker`
 * for why the failure is a value here rather than an exception.
 */
fn collect(ss : Shared<Session>, nowMs : i64, jobs : Future<string>[2]) : bool {
    let mut q : Queue = ss.q;
    let mut hosts : Hosts = ss.w.hosts;
    let mut changed : bool = false;

    if (q.inFlight && !jobs[0].isAlive()) {
        let body : string = await jobs[0];
        if (ipapi::absorb(q, ss.w, body, ss.a.scratch)) {
            q.succeeded(hosts, nowMs);
            changed = true;
        } else {
            q.failed(hosts, nowMs);
        }
    }

    if (q.whoisInFlight && !jobs[1].isAlive()) {
        let body : string = await jobs[1];
        let h : i32 = q.whoisHost;
        if (h >= 0) {
            if (q.whoisKind == WhoisKind::Ptr) {
                changed = tookName(ss.w, h, body) || changed;
            } else {
                // `Net::origin` asks both Team Cymru zones, so one answer
                // carries the number and the name together.
                changed = tookOrigin(ss.w, h, body) || changed;
            }
        }

        q.whoisDone(nowMs);
    }

    return changed;
}

/**
 * Start whatever may be started now. The batch goes first: it answers for a
 * hundred addresses at once, and the registry lookups only exist to fill the
 * gaps it leaves.
 */
fn dispatch(ss : Shared<Session>, nowMs : i64, jobs : Future<string>[2]) : void {
    let mut q : Queue = ss.q;
    let hosts : Hosts = ss.w.hosts;
    if (q.ready(nowMs) && queue::pending(hosts)) {
        jobs[0] = spawn worker::post(queue::batchUrl(), queue::build(q, hosts, ss.a.scratch));
        q.inFlight = true;
    }

    if (!q.whoisReady(nowMs)) {
        return;
    }

    // The registry, in one DNS lookup: `Net::origin` asks the origin zone and
    // then the AS-name zone, and answers both.
    let origin : i32 = needsOrigin(hosts);
    if (origin >= 0) {
        q.whoisHost = origin;
        q.whoisKind = WhoisKind::Origin;
        hosts.ask(origin, ASKED_ORIGIN);
        jobs[1] = spawn worker::origin(netAddr(hosts.addrAt(origin), hosts.family[origin]));
        q.whoisInFlight = true;
        return;
    }

    // Last, and weakest: what the address's own owner publishes. It never
    // overwrites a name the machine itself resolved.
    let nameless : i32 = firstUnnamed(hosts);
    if (nameless >= 0) {
        q.whoisHost = nameless;
        q.whoisKind = WhoisKind::Ptr;
        jobs[1] = spawn worker::reverse(netAddr(hosts.addrAt(nameless), hosts.family[nameless]));
        q.whoisInFlight = true;
    }
}

/** Fold a reverse-lookup answer into row `h`. */
fn tookName(w : World, h : i32, body : string) : bool {    // Measured before it is interned, so an empty answer never reaches the
    // run at all — there is nothing to retract, and no offset whose meaning
    // depends on nothing having been interned since.
    let len : i32 = w.pool.measure(body, HOST_MAX);
    if (len > 0) {
        let off : i64 = w.pool.putString(body, HOST_MAX);
        if (off >= 0) {
            w.hosts.name(h, off, len, NameSource::Ptr);
            return true;
        }
    }

    // Nothing published, or nothing the pool could hold. The row keeps its
    // address, and `nameFrom` records that a source has now answered — so
    // the question is asked once and not once a second forever. A name the
    // cache supplied while the lookup was in flight keeps its own source.
    if (w.hosts.nameFrom[h] == NameSource::None) {
        w.hosts.nameFrom[h] = NameSource::Ptr;
    }

    return false;
}

/**
 * Fold an origin answer into row `h`: the number `Net::origin` read, a `|`,
 * and the title it built (`AS13335 Cloudflare, Inc.`). The number goes in the
 * AS column; the title is what the network column shows.
 */
fn tookOrigin(w : World, h : i32, body : string) : bool {
    let n : i64 = body.byteLength;
    if (n <= 0) {
        return false;
    }

    let mut bar : i64 = -1;
    let mut asn : i32 = 0;
    for (i of 0..n) {
        let c : i32 = body.byteAt(i);
        if (bar < 0) {
            if (c == 124) {
                bar = i;
            } else if (c >= 48 && c <= 57) {
                asn = asn * 10 + (c - 48);
            } else {
                return false;
            }
        }
    }

    if (bar <= 0 || asn <= 0) {
        return false;
    }

    let off : i64 = w.pool.putRange(body, bar + 1, n, ORG_MAX);
    if (off < 0) {
        return false;
    }

    w.hosts.netOff[h] = off;
    w.hosts.netLen[h] = (w.pool.used() - off) as i32;
    w.hosts.asn[h] = asn;
    return true;
}

/**
 * A routable address whose announcing network is still unknown and has not
 * been asked about — including one the batch failed for, which is exactly
 * the address the registry fallback exists for.
 */
fn needsOrigin(hosts : Hosts) : i32 {
    for (h of 0..hosts.count) {
        if (hosts.settled(h) && hosts.reach[h] == Reach::Public && hosts.netOff[h] < 0
            && hosts.asn[h] == 0 && !hosts.wasAsked(h, ASKED_ORIGIN)) {
            return h;
        }
    }

    return -1;
}

/** The first routable address that came back from its lookup with no name. */
fn firstUnnamed(hosts : Hosts) : i32 {
    for (h of 0..hosts.count) {
        if (hosts.unnamed(h) && hosts.nameFrom[h] == NameSource::None) {
            return h;
        }
    }

    return -1;
}

/**
 * Join whatever is still in flight before the window closes. A spawned
 * thread outliving `main` would be a thread writing into tables that are
 * being freed, so the wait is short and the alternative is not.
 */
fn drain(q : Queue, jobs : Future<string>[2]) : void {
    if (q.inFlight) {
        await jobs[0];
        q.inFlight = false;
    }

    if (q.whoisInFlight) {
        await jobs[1];
        q.whoisInFlight = false;
    }
}

/**
 * One reading of the machine, folded into the journal.
 *
 * The order is the pipeline's: the process list first, because a connection
 * cannot be attributed to a program that has not been named; then the
 * sockets; then the scores, which read whatever the enrichment has folded
 * in; then the ranking, which reads the scores; then the cards, which reduce
 * all of it.
 */
fn refresh(ss : Shared<Session>, nowMs : i64, trace : dyn TraceReader) : void {
    let w : World = ss.w;
    let mut mach : Machine = ss.mach;
    mach.procs.refresh(w.pool);
    mach.conns.refresh();
    absorbSnapshot(w, mach, nowMs);

    // The trace's counts are per process, and the journal is per conversation.
    // The delta is folded into the program, which is the finest partition the
    // trace itself offers; nothing here splits it across sockets.
    trace.poll();
    creditTraffic(w, mach, nowMs, trace);

    score::assessAll(w.eps, w.hosts);
    rank(w.eps, nowMs);
    pulse::sample(w);

    mach.tiers.poll = match mach.conns.ok {
        true => TierState::On,
        false => TierState::Off,
    };
    mach.tiers.etw = match trace.status().state {
        ReadingState::On => TierState::On,
        ReadingState::Lost => TierState::Lost,
        ReadingState::Off => TierState::Off,
    };
}

/** Give this tick's per-process deltas to the programs they belong to. */
fn creditTraffic(w : World, mach : Machine, nowMs : i64, trace : dyn TraceReader) : void {
    if (!trace.running()) {
        return;
    }

    for (i of 0..trace.size()) {
        let inBytes : i64 = trace.receivedAt(i);
        let outBytes : i64 = trace.sentAt(i);
        if (inBytes == 0 && outBytes == 0) {
            continue;
        }

        let g : i32 = w.groups.forPid(w.pool, mach.procs, trace.pidAt(i));
        if (g >= 0) {
            w.groups.credit(g, inBytes, outBytes, nowMs);
        }
    }
}

/**
 * The instant a scripted capture is due, or `0` when none was asked for.
 * `--snap <ms>` waits that long, writes the frame, and quits.
 */
fn snapDeadline() : i64 {
    let mut i : i32 = 1;
    while (i < argc()) {
        try {
            if (argAt(i) == "--snap") {
                if (i + 1 < argc()) {
                    let ms : i64 = argAt(i + 1).toI64();
                    if (ms > 0) {
                        return ms;
                    }
                }

                return 3000;
            }
        } catch e : IndexOutOfBoundsException {
            return 0;
        } catch e : ParseException {
            return 3000;
        }

        i = i + 1;
    }

    return 0;
}

/**
 * What a scripted capture opens before it is taken: `detail`, the sheet of the
 * first endpoint, or `help`. Empty — the page alone — when none was named.
 */
fn snapPane() : string {
    let mut i : i32 = 1;
    while (i < argc()) {
        try {
            if (argAt(i) == "--snap" && i + 2 < argc()) {
                return argAt(i + 2);
            }
        } catch e : IndexOutOfBoundsException {
            return "";
        }

        i = i + 1;
    }

    return "";
}

/** Pick the first endpoint row and activate it, as Enter would. */
fn openFirstEndpoint(ss : Shared<Session>) : void {
    let v : Rows = ss.w.view;
    for (r of 0..v.count) {
        if (v.rowKind[r as i64] == RowKind::Endpoint) {
            let key : i64 = actions::rowKey(ss, r);
            ss.a.grid.pick(key);
            ss.a.grid.activate(key);
            return;
        }
    }
}

/**
 * Play a capture's keys into the view: `/,g,h,Down,Enter` — a single character
 * is typed, a name is a key pressed. It is how the window's keyboard is checked
 * without a keyboard, and without sending anything to whatever else is on screen.
 */
fn feed(view : View, spec : string) : void {
    let n : i64 = spec.byteLength;
    let mut from : i64 = 0;
    let mut i : i64 = 0;
    while (i <= n) {
        if (i == n || spec.byteAt(i) == 44) {
            if (i > from) {
                press(view, Strings::slice(spec, from, i));
            }

            from = i + 1;
        }

        i = i + 1;
    }
}

/** One token of a capture's keys. */
fn press(view : View, token : string) : void {
    let key : Key = keyNamed(token);
    if (key != Key::Other) {
        view.input(UiEvent { kind: EventKind::KeyDown, key: key });
        view.input(UiEvent { kind: EventKind::KeyUp, key: key });
        return;
    }

    if (token.byteLength == 1) {
        view.input(UiEvent { kind: EventKind::Text, cp: token.byteAt(0) });
    }
}

/** The key a token names, or `Other`. */
fn keyNamed(token : string) : Key {
    return match token {
        "Down" => Key::Down,
        "Up" => Key::Up,
        "Left" => Key::Left,
        "Right" => Key::Right,
        "Enter" => Key::Enter,
        "Space" => Key::Space,
        "Escape" => Key::Escape,
        "Tab" => Key::Tab,
        "PageDown" => Key::PageDown,
        "PageUp" => Key::PageUp,
        "Home" => Key::Home,
        "End" => Key::End,
        "Backspace" => Key::Backspace,
        _ => Key::Other,
    };
}
